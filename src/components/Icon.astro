const brand = (i: { path: string }) => `<path fill="currentColor" d="${i.path}"/>`;
Object.assign(icons, {
  github: brand(siGithub),
  x: brand(siX),
  telegram: brand(siTelegram),
  bilibili: brand(siBilibili),
  weibo: brand(siSinaweibo),
  zhihu: brand(siZhihu),
  steam: brand(siSteam),
  instagram: brand(siInstagram),
});
const body = icons[name] ?? icons.link;
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={body} />
