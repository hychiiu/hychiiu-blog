---
/**
 * 侧边 Dock（桌面端左侧竖排 / 窄屏底部横排）
 * - transition:persist：ClientRouter 跳转时保留同一个 DOM，激活态 / 语言 / 链接由脚本在每次跳转后更新
 * - 桌面端鼠标悬停时按距离做高斯放大（rAF + 临界阻尼指数插值，无回弹，只改 transform）
 */
import { site, type Lang } from '../site.config';
import { ui, localizePath } from '../i18n';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const nav = [
  { key: 'home', icon: 'home', path: '/' },
  { key: 'posts', icon: 'posts', path: '/posts/' },
  { key: 'notes', icon: 'notes', path: '/notes/' },
  { key: 'about', icon: 'about', path: '/about/' },
] as const;
const label = (l: Lang, k: string) => (ui[l] as Record<string, unknown>)[`nav.${k}`] as string;
---

<nav class="dock" data-dock transition:persist="dock" aria-label="Dock">
  <div class="dock-bg" aria-hidden="true"></div>
  <ul class="dock-list" data-dock-list>
    <li class="dock-item" data-mag>
      <a
        class="dock-btn avatar"
        href={localizePath(lang, '/')}
        data-home
        data-astro-prefetch="load"
        data-href-zh={localizePath('zh', '/')}
        data-href-en={localizePath('en', '/')}
        aria-label={site.name}
      >
        <span class="ico">
          <img src={site.avatar} alt="" width="40" height="40" />
        </span>
      </a>
      <span class="tip" aria-hidden="true">
        {site.name}
        {site.nameCJK && <em> {site.nameCJK}</em>}
      </span>
    </li>
    <li class="dock-sep" aria-hidden="true"></li>
    {nav.map((n) => (
      <li class="dock-item" data-mag data-key={n.key} data-tone={n.key}>
        <a
          class="dock-btn"
          href={localizePath(lang, n.path)}
          data-nav={n.key}
          data-astro-prefetch="load"
          data-href-zh={localizePath('zh', n.path)}
          data-href-en={localizePath('en', n.path)}
          data-label-zh={label('zh', n.key)}
          data-label-en={label('en', n.key)}
          aria-label={label(lang, n.key)}
        >
          <span class="ico">
            <Icon name={n.icon} size={18} />
          </span>
        </a>
        <span class="tip" aria-hidden="true" data-tip>
          {label(lang, n.key)}
        </span>
      </li>
    ))}
    <li class="dock-sep" aria-hidden="true"></li>
    <li class="dock-item" data-mag data-tone="lang">
      <a
        class="dock-btn lang"
        data-astro-prefetch="load"
        href={alternates[other]}
        hreflang={other === 'zh' ? 'zh-CN' : 'en'}
        data-set-lang={other}
        data-lang-switch
        aria-label={ui[lang]['toggle.lang']}
      >
        <span class="ico">
          <span class="lang-glyph" data-lang-glyph data-cjk={other === 'zh' ? '' : undefined}>
            {other === 'zh' ? '中' : 'EN'}
          </span>
        </span>
      </a>
      <span class="tip" aria-hidden="true" data-lang-tip>
        {other === 'zh' ? '中文' : 'English'}
      </span>
    </li>
    <li class="dock-item" data-mag data-tone="theme">
      <button
        type="button"
        class="dock-btn"
        data-theme-toggle
        aria-label={ui[lang]['toggle.theme']}
        data-label-zh={ui.zh['toggle.theme']}
        data-label-en={ui.en['toggle.theme']}
      >
        <span class="ico theme-ico">
          <Icon name="sun" size={17} class="i-sun" />
          <Icon name="moon" size={17} class="i-moon" />
        </span>
      </button>
      <span class="tip" aria-hidden="true" data-tip>
        {ui[lang]['toggle.theme']}
      </span>
    </li>
  </ul>
  <span class="dock-dot" data-dock-dot aria-hidden="true"></span>
</nav>

<style is:global>
  :root {
    --dock-size: 40px;
    --dock-gap: 6px;
    --dock-pad: 9px;
  }
  .dock {
    view-transition-name: dock;
    position: fixed;
    z-index: 70;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    -webkit-tap-highlight-color: transparent;
  }
  .dock-bg {
    position: absolute;
    inset: calc(-1 * var(--grow-y, 0px)) calc(-1 * var(--grow-x, 0px)) calc(-1 * var(--grow-y, 0px)) 0;
    border-radius: var(--r-pill);
    background: rgb(250 249 245 / 0.72);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    border: 0.5px solid rgb(24 24 27 / 0.1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      var(--shadow-float);
  }
  :root[data-theme='dark'] .dock-bg {
    background: rgb(28 28 30 / 0.7);
    border-color: rgb(255 255 255 / 0.08);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      var(--shadow-float);
  }
  .dock-list {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--dock-gap);
    margin: 0;
    padding: var(--dock-pad);
    list-style: none;
  }
  .dock-item {
    position: relative;
    width: var(--dock-size);
    height: var(--dock-size);
    transform: translate3d(0, var(--ty, 0px), 0);
    will-change: transform;
  }
  .dock-sep {
    width: 22px;
    height: 0.5px;
    margin: 2px 0;
    background: color-mix(in srgb, var(--n-10) 16%, transparent);
    transform: translate3d(0, var(--ty, 0px), 0);
  }
  .dock-btn {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    background: transparent;
    color: var(--n-7);
    font: inherit;
    cursor: pointer;
    transform: scale(var(--s, 1));
    transform-origin: left center;
    will-change: transform;
    transition:
      color var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease);
  }
  .dock-btn .ico {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    transition: transform var(--dur-2) var(--ease);
  }
  .dock-btn:active .ico {
    transform: scale(0.88);
    transition-duration: 0.08s;
  }
  .dock-btn:hover,
  .dock-btn[aria-current='page'] {
    color: var(--n-10);
  }
  .dock-btn:hover {
    background: color-mix(in srgb, var(--n-10) 5%, transparent);
  }
  .dock-btn:focus-visible {
    outline: 1.5px solid var(--accent);
    outline-offset: 2px;
  }
  .dock-btn.avatar {
    border-radius: var(--r-round);
  }
  ::view-transition-old(dock),
  ::view-transition-new(dock),
  ::view-transition-group(dock) {
    animation: none;
  }
  ::view-transition-old(dock) {
    display: none;
  }

  /* 彩色圆形图标：柔和渐变 + 顶部高光 + 细描边 + 柔和投影 */
  .dock-item[data-tone] {
    --c1: #b9b6ae;
    --c2: #8f8c85;
    --glow: rgb(24 24 27 / 0.28);
  }
  .dock-item[data-tone='home'] {
    --c1: #e29aa5;
    --c2: #c56473;
    --glow: rgb(197 100 115 / 0.45);
  }
  .dock-item[data-tone='posts'] {
    --c1: #9fb1e0;
    --c2: #5f73b8;
    --glow: rgb(95 115 184 / 0.42);
  }
  .dock-item[data-tone='notes'] {
    --c1: #eccb86;
    --c2: #c9973f;
    --glow: rgb(201 151 63 / 0.42);
  }
  .dock-item[data-tone='about'] {
    --c1: #9fcbbb;
    --c2: #5d9483;
    --glow: rgb(93 148 131 / 0.42);
  }
  .dock-item[data-tone='lang'] {
    --c1: #c2aee0;
    --c2: #8565b5;
    --glow: rgb(133 101 181 / 0.42);
  }
  .dock-item[data-tone='theme'] {
    --c1: #a9b3c4;
    --c2: #5f6b80;
    --glow: rgb(95 107 128 / 0.42);
  }
  :root[data-theme='dark'] .dock-item[data-tone='home'] {
    --c1: #c8717f;
    --c2: #8e4150;
    --glow: rgb(0 0 0 / 0.5);
  }
  :root[data-theme='dark'] .dock-item[data-tone='posts'] {
    --c1: #7486c4;
    --c2: #3d4c86;
    --glow: rgb(0 0 0 / 0.5);
  }
  :root[data-theme='dark'] .dock-item[data-tone='notes'] {
    --c1: #cfa152;
    --c2: #8c6526;
    --glow: rgb(0 0 0 / 0.5);
  }
  :root[data-theme='dark'] .dock-item[data-tone='about'] {
    --c1: #6fa595;
    --c2: #3e6b5d;
    --glow: rgb(0 0 0 / 0.5);
  }
  :root[data-theme='dark'] .dock-item[data-tone='lang'] {
    --c1: #9a7dc6;
    --c2: #5c4488;
    --glow: rgb(0 0 0 / 0.5);
  }
  :root[data-theme='dark'] .dock-item[data-tone='theme'] {
    --c1: #5d6a82;
    --c2: #2c3340;
    --glow: rgb(0 0 0 / 0.5);
  }
  .dock-item[data-tone] .dock-btn {
    border-radius: var(--r-round);
    color: #fff;
    background: linear-gradient(160deg, var(--c1), var(--c2));
    box-shadow:
      inset 0 0 0 0.5px rgb(0 0 0 / 0.1),
      inset 0 1px 0.5px rgb(255 255 255 / 0.45),
      0 1px 1.5px rgb(0 0 0 / 0.1),
      0 5px 12px -5px var(--glow);
  }
  .dock-item[data-tone] .dock-btn .ico {
    position: relative;
    border-radius: var(--r-round);
    overflow: hidden;
  }
  /* 顶部玻璃高光 */
  .dock-item[data-tone] .dock-btn .ico::before {
    content: '';
    position: absolute;
    inset: 1px 4px 52% 4px;
    border-radius: 50% 50% 45% 45% / 70% 70% 30% 30%;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.38), rgb(255 255 255 / 0));
    pointer-events: none;
  }
  .dock-item[data-tone] .dock-btn svg,
  .dock-item[data-tone] .lang-glyph {
    position: relative;
    filter: drop-shadow(0 0.5px 0.5px rgb(0 0 0 / 0.18));
  }
  .dock-item[data-tone] .dock-btn:hover,
  .dock-item[data-tone] .dock-btn[aria-current='page'] {
    color: #fff;
    background: linear-gradient(160deg, var(--c1), var(--c2));
  }
  .dock-item[data-tone] .dock-btn:hover {
    filter: brightness(1.04) saturate(1.05);
  }
  /* 放大模式下不再叠加底色，像 Dock 一样只用尺寸表达悬停 */
  .dock.is-mag .dock-item:not([data-tone]) .dock-btn:hover {
    background: transparent;
  }
  .dock-btn.avatar:hover {
    background: transparent;
  }
  .dock-btn.avatar img {
    width: 100%;
    height: 100%;
    border-radius: var(--r-round);
    object-fit: cover;
    box-shadow:
      0 0 0 0.5px rgb(24 24 27 / 0.14),
      0 2px 6px -2px rgb(24 24 27 / 0.25);
  }
  .lang-glyph {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .lang-glyph[data-cjk] {
    font-family: var(--font-serif);
    font-size: var(--fs-ui);
  }
  .theme-ico svg {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-4) var(--ease);
  }
  .theme-ico .i-moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
  :root[data-theme='dark'] .theme-ico .i-sun {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
  :root[data-theme='dark'] .theme-ico .i-moon {
    opacity: 1;
    transform: none;
  }

  /* tooltip chip */
  .tip {
    position: absolute;
    left: 100%;
    top: 50%;
    margin-left: 14px;
    padding: 4px 12px 5px;
    border-radius: var(--r-pill);
    white-space: nowrap;
    pointer-events: none;
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    line-height: 1.3;
    color: var(--n-9);
    background: rgb(250 249 245 / 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 0.5px solid rgb(24 24 27 / 0.1);
    box-shadow: 0 6px 18px -8px rgb(24 24 27 / 0.22);
    opacity: 0;
    transform: translate3d(calc(var(--dx, 0px) - 6px), -50%, 0);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease);
  }
  .tip em {
    font-style: normal;
    color: var(--n-6);
  }
  :root[data-theme='dark'] .tip {
    background: rgb(36 35 33 / 0.92);
    border-color: rgb(255 255 255 / 0.08);
    box-shadow: 0 8px 22px -8px rgb(0 0 0 / 0.6);
  }
  .dock-item:hover .tip,
  .dock-item:has(:focus-visible) .tip {
    opacity: 1;
    transform: translate3d(var(--dx, 0px), -50%, 0);
  }

  /* running indicator */
  .dock-dot {
    position: absolute;
    left: 5px;
    top: 0;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: var(--r-round);
    background: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent);
    opacity: 0;
    transform: translate3d(var(--dot-x, 0px), var(--dot-y, 0px), 0);
    transition: opacity var(--dur-3) var(--ease);
    pointer-events: none;
  }
  .dock-dot.on {
    opacity: 1;
  }

  /* desktop: keep content clear of the dock */
  @media (min-width: 1024px) and (max-width: 1359px) {
    body {
      padding-left: 84px;
    }
  }

  /* narrow screens: floating bottom dock */
  @media (max-width: 1023px) {
    :root {
      --dock-size: 38px;
      --dock-gap: 4px;
      --dock-pad: 6px;
    }
    .dock {
      left: 50%;
      top: auto;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
    }
    .dock-list {
      flex-direction: row;
    }
    .dock-bg {
      inset: 0;
      border-radius: var(--r-pill);
    }
    .dock-sep {
      width: 0.5px;
      height: 20px;
      margin: 0 3px;
    }
    .tip {
      display: none;
    }
    .dock-dot {
      left: 0;
      top: auto;
      bottom: 3px;
      margin: 0 0 0 -2px;
    }
    body {
      padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (max-width: 360px) {
    :root {
      --dock-size: 34px;
    }
  }
  @media (hover: none) {
    .dock-btn:hover {
      background: transparent;
    }
    .dock-btn:active {
      background: color-mix(in srgb, var(--n-10) 6%, transparent);
    }
  }
</style>

<script>
  import '../scripts/dock/index';
</script>
