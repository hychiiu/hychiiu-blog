---
/**
 * 侧边 Dock（桌面端左侧竖排 / 窄屏底部横排）
 * - transition:persist：ClientRouter 跳转时保留同一个 DOM，激活态 / 语言 / 链接由脚本在每次跳转后更新
 * - 桌面端鼠标悬停时按距离做高斯放大（rAF + 临界阻尼指数插值，无回弹，只改 transform）
 */
import { site, type Lang } from '../site.config';
import { ui, localizePath } from '../i18n';
import Icon from './Icon.astro';
import '../styles/dock.css';
interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const nav = [
  { key: 'home', icon: 'home', path: '/' },
  { key: 'posts', icon: 'posts', path: '/posts/' },
  { key: 'notes', icon: 'notes', path: '/notes/' },
  { key: 'about', icon: 'about', path: '/about/' },
] as const;
const label = (l: Lang, k: string) => (ui[l] as Record<string, unknown>)[`nav.${k}`] as string;
---

<nav class="dock" data-dock transition:persist="dock" aria-label="Dock">
  <div class="dock-bg" aria-hidden="true"></div>
  <ul class="dock-list" data-dock-list>
    <li class="dock-item" data-mag>
      <a
        class="dock-btn avatar"
        href={localizePath(lang, '/')}
        data-home
        data-astro-prefetch="load"
        data-href-zh={localizePath('zh', '/')}
        data-href-en={localizePath('en', '/')}
        aria-label={site.name}
      >
        <span class="ico">
          <img src={site.avatar} alt="" width="40" height="40" />
        </span>
      </a>
      <span class="tip" aria-hidden="true">
        {site.name}
        {site.nameCJK && <em> {site.nameCJK}</em>}
      </span>
    </li>
    <li class="dock-sep" aria-hidden="true"></li>
    {nav.map((n) => (
      <li class="dock-item" data-mag data-key={n.key} data-tone={n.key}>
        <a
          class="dock-btn"
          href={localizePath(lang, n.path)}
          data-nav={n.key}
          data-astro-prefetch="load"
          data-href-zh={localizePath('zh', n.path)}
          data-href-en={localizePath('en', n.path)}
          data-label-zh={label('zh', n.key)}
          data-label-en={label('en', n.key)}
          aria-label={label(lang, n.key)}
        >
          <span class="ico">
            <Icon name={n.icon} size={18} />
          </span>
        </a>
        <span class="tip" aria-hidden="true" data-tip>
          {label(lang, n.key)}
        </span>
      </li>
    ))}
    <li class="dock-sep" aria-hidden="true"></li>
    <li class="dock-item" data-mag data-tone="lang">
      <a
        class="dock-btn lang"
        data-astro-prefetch="load"
        href={alternates[other]}
        hreflang={other === 'zh' ? 'zh-CN' : 'en'}
        data-set-lang={other}
        data-lang-switch
        aria-label={ui[lang]['toggle.lang']}
      >
        <span class="ico">
          <span class="lang-glyph" data-lang-glyph data-cjk={other === 'zh' ? '' : undefined}>
            {other === 'zh' ? '中' : 'EN'}
          </span>
        </span>
      </a>
      <span class="tip" aria-hidden="true" data-lang-tip>
        {other === 'zh' ? '中文' : 'English'}
      </span>
    </li>
    <li class="dock-item" data-mag data-tone="theme">
      <button
        type="button"
        class="dock-btn"
        data-theme-toggle
        aria-label={ui[lang]['toggle.theme']}
        data-label-zh={ui.zh['toggle.theme']}
        data-label-en={ui.en['toggle.theme']}
      >
        <span class="ico theme-ico">
          <Icon name="sun" size={17} class="i-sun" />
          <Icon name="moon" size={17} class="i-moon" />
        </span>
      </button>
      <span class="tip" aria-hidden="true" data-tip>
        {ui[lang]['toggle.theme']}
      </span>
    </li>
  </ul>
  <span class="dock-dot" data-dock-dot aria-hidden="true"></span>
</nav>

<script>
  import '../scripts/dock/index';
</script>
