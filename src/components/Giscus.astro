---
import { site, giscusEnabled, type Lang } from '../site.config';
import { useT } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'zh' } = Astro.props;
const t = useT(lang);
const g = site.giscus;
---
{giscusEnabled && (
  <section class="comments" aria-label={t('post.comments')}>
    <h2 class="eyebrow">{t('post.comments')}</h2>
    <div
      class="giscus-slot"
      data-giscus
      data-repo={g.repo}
      data-repo-id={g.repoId}
      data-category={g.category}
      data-category-id={g.categoryId}
      data-mapping={g.mapping}
      data-lang={lang === 'zh' ? 'zh-CN' : 'en'}
    ></div>
  </section>
)}

<style>
  .comments {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .comments h2 {
    margin-bottom: 1.25rem;
  }
</style>

<script>
  const theme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark_dimmed' : 'light');
  window.addEventListener('themechange', () => {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
  });
  // 每次进入页面（含 ClientRouter 站内跳转）重新挂载评论
  document.addEventListener('astro:page-load', () => {
  const slot = document.querySelector<HTMLElement>('[data-giscus]');
  if (slot && !slot.querySelector('script, iframe')) {
    const d = slot.dataset;
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    const attrs: Record<string, string> = {
      'data-repo': d.repo!,
      'data-repo-id': d.repoId!,
      'data-category': d.category!,
      'data-category-id': d.categoryId!,
      'data-mapping': d.mapping || 'pathname',
      'data-strict': '0',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'top',
      'data-theme': theme(),
      'data-lang': d.lang || 'zh-CN',
      'data-loading': 'lazy',
    };
    Object.entries(attrs).forEach(([k, v]) => s.setAttribute(k, v));
    slot.appendChild(s);
  }
  });
</script>
