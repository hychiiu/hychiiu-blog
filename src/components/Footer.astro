---
import { site, type Lang } from '../site.config';
import { localizePath, useT } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const startYear = new Date(site.startDate).getFullYear();
---
<footer class="footer">
  <div class="shell">
    <div class="inner">
      <span>© {startYear === year ? year : `${startYear}–${year}`} {site.name}{site.nameCJK && <span class="cn"> · {site.nameCJK}</span>}</span>
      <span class="links">
        <a href={localizePath(lang, '/rss.xml')}>rss</a>
        <span aria-hidden="true">·</span>
        <a href="/sitemap-index.xml">sitemap</a>
        <span aria-hidden="true">·</span>
        <span>{t('footer.built')}</span>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 96px;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 20px 0 40px;
    border-top: 1px solid var(--hair);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--n-7);
    letter-spacing: 0.02em;
  }
  .cn {
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 8px;
  }
  a {
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--accent);
  }
</style>
