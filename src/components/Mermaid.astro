---
/**
 * Mermaid 图：只有页面里存在 ```mermaid 时才按需加载（空闲时渲染，跟随深浅色重绘，兼容 ClientRouter）。
 * 渲染后支持缩放 / 平移（src/scripts/pan-zoom.ts）：hover 出现幽灵控制条 + / − / 复位 / 全屏，
 * Ctrl/⌘ + 滚轮或触控板捏合缩放，拖拽平移，双击复位；全屏灯箱内滚轮直接缩放。见 docs/DESIGN.md §7 Mermaid。
 */
---
<script>
  import { panZoom, type PanZoom } from '../scripts/pan-zoom';

  const ICONS = {
    in: '<path d="M8 3.5v9M3.5 8h9"/>',
    out: '<path d="M3.5 8h9"/>',
    reset: '<path d="M3.2 8a4.8 4.8 0 1 0 1.4-3.4M3.2 2.8v2.4h2.4"/>',
    full: '<path d="M2.8 6V2.8H6M10 2.8h3.2V6M13.2 10v3.2H10M6 13.2H2.8V10"/>',
    close: '<path d="M4 4l8 8M12 4l-8 8"/>',
  } as const;
  type Act = keyof typeof ICONS;
  const T = {
    zh: { in: '放大', out: '缩小', reset: '复位', full: '全屏查看', close: '关闭', hint: '⌘/Ctrl + 滚轮缩放 · 拖拽平移 · 双击复位' },
    en: { in: 'Zoom in', out: 'Zoom out', reset: 'Reset', full: 'Fullscreen', close: 'Close', hint: '⌘/Ctrl + scroll to zoom · drag to pan · double-click to reset' },
  };
  const tr = () => T[document.documentElement.lang.startsWith('zh') ? 'zh' : 'en'];

  function toolbar(acts: Act[]) {
    const bar = document.createElement('div');
    bar.className = 'mmd-ctrl';
    bar.innerHTML = acts
      .map((a) => `<button type="button" data-act="${a}" aria-label="${tr()[a]}" title="${tr()[a]}"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[a]}</svg></button>`)
      .join('');
    return bar;
  }
  function wire(bar: HTMLElement, pz: PanZoom, extra: Partial<Record<Act, () => void>> = {}) {
    bar.addEventListener('click', (e) => {
      const act = (e.target as Element).closest<HTMLElement>('[data-act]')?.dataset.act as Act | undefined;
      if (act === 'in') pz.zoomBy(1.25);
      else if (act === 'out') pz.zoomBy(0.8);
      else if (act === 'reset') pz.reset();
      else if (act) extra[act]?.();
    });
  }

  /** 全屏灯箱：<dialog> 模态，Esc / 点击背景关闭 */
  function openLightbox(svg: SVGElement) {
    const dlg = document.createElement('dialog');
    dlg.className = 'mmd-lightbox';
    const stage = document.createElement('div');
    stage.className = 'mmd-lb-stage';
    const content = document.createElement('div');
    content.className = 'mmd-lb-content';
    content.appendChild(svg.cloneNode(true));
    stage.appendChild(content);
    const bar = toolbar(['in', 'out', 'reset', 'close']);
    dlg.append(stage, bar);
    document.body.appendChild(dlg);
    const pz = panZoom(stage, content, { free: true });
    const close = () => dlg.close();
    wire(bar, pz, { close });
    dlg.addEventListener('click', (e) => e.target === dlg && close());
    dlg.addEventListener('close', () => {
      pz.destroy();
      dlg.remove();
    });
    dlg.showModal();
  }

  /** 给渲染好的图加上缩放平移与控制条（每个容器只做一次） */
  function enhance(pre: HTMLElement) {
    const wrap = pre.closest<HTMLElement>('.mermaid-wrap');
    if (!wrap || wrap.dataset.pz != null) return;
    wrap.dataset.pz = '';
    wrap.title = tr().hint;
    const pz = panZoom(wrap, pre);
    const bar = toolbar(['in', 'out', 'reset', 'full']);
    wire(bar, pz, {
      full: () => {
        const svg = pre.querySelector('svg');
        if (svg) openLightbox(svg);
      },
    });
    wrap.appendChild(bar);
  }

  const palette = (dark: boolean) => {
    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#c56473';
    return dark
      ? { background: '#18181a', primaryColor: '#24231f', primaryTextColor: '#f0efeb', primaryBorderColor: '#5c5a55', secondaryColor: '#2a2926', tertiaryColor: '#1f1e1c', lineColor: '#a8a69f', textColor: '#e3e1db', noteBkgColor: '#2a2926', noteTextColor: '#e3e1db', noteBorderColor: '#5c5a55', edgeLabelBackground: '#18181a', clusterBkg: '#1f1e1c', clusterBorder: '#403f3a', accent }
      : { background: '#faf9f5', primaryColor: '#f0efeb', primaryTextColor: '#24231f', primaryBorderColor: '#a8a69f', secondaryColor: '#f6f4ee', tertiaryColor: '#f9f8f5', lineColor: '#787670', textColor: '#24231f', noteBkgColor: '#f6f0ea', noteTextColor: '#24231f', noteBorderColor: '#d0cec6', edgeLabelBackground: '#faf9f5', clusterBkg: '#f6f4ee', clusterBorder: '#d0cec6', accent };
  };
  let seq = 0;
  const render = async () => {
    const blocks = [...document.querySelectorAll<HTMLElement>('pre[data-mermaid]')];
    if (!blocks.length) return;
    for (const b of blocks) b.dataset.src ??= b.textContent ?? '';
    const { default: mermaid } = await import('mermaid');
    const dark = document.documentElement.dataset.theme === 'dark';
    const { accent, ...vars } = palette(dark);
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      fontFamily: "'Noto Serif SC', 'Noto Serif CJK SC', serif",
      themeVariables: { ...vars, fontSize: '14px', darkMode: dark, actorBorder: vars.primaryBorderColor, signalColor: vars.lineColor, labelBoxBorderColor: accent },
    });
    await Promise.all(
      blocks.map(async (el) => {
        const src = el.dataset.src!;
        try {
          const { svg } = await mermaid.render(`mmd-${seq++}`, src);
          el.innerHTML = svg;
          el.dataset.rendered = '';
          enhance(el);
        } catch (err) {
          el.textContent = src;
          el.dataset.error = '';
          console.error(err);
        }
      }),
    );
  };
  const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 800 }) : setTimeout(fn, 50));
  document.addEventListener('astro:page-load', () => idle(render));
  let lastTheme = document.documentElement.dataset.theme;
  new MutationObserver(() => {
    const t = document.documentElement.dataset.theme;
    if (t !== lastTheme) {
      lastTheme = t;
      render();
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
