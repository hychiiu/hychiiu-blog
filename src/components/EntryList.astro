---
import { formatDate, readingMinutes } from '../utils/content';

export interface Item {
  href: string;
  title: string;
  date: Date;
  description?: string;
  kind?: 'post' | 'note';
  body?: string;
}
interface Props {
  items: Item[];
  showKind?: boolean;
  startIndex?: number;
}
const { items, showKind = false, startIndex = 0 } = Astro.props;
---
<ul class="entries">
  {items.map((it, i) => (
    <li class="reveal" style={`--i:${startIndex + i}`}>
      <a href={it.href} class="entry">
        <div class="entry-main">
          <h3 class="entry-title">{it.title}</h3>
          {it.description && <p class="entry-desc">{it.description}</p>}
          <div class="entry-meta">
            {showKind && it.kind === 'note' && <span class="kind">手记</span>}
            <time datetime={it.date.toISOString()}>{formatDate(it.date)}</time>
            {it.body && it.kind !== 'note' && <span>· {readingMinutes(it.body)} 分钟读完</span>}
          </div>
        </div>
        <span class="entry-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem;
    margin: 0 -1rem;
    padding: 1.15rem 1rem;
    border-radius: 12px;
    transition: background 0.25s var(--ease-out);
  }
  .entry:hover {
    background: var(--n-2);
  }
  :global(:root[data-theme='dark']) .entry:hover {
    background: var(--n-1);
  }
  .entry-title {
    font-size: 17px;
    line-height: 1.5;
    color: var(--n-10);
    transition: color 0.2s;
  }
  .entry:hover .entry-title {
    color: var(--accent);
  }
  .entry-desc {
    margin: 0.3rem 0 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--n-7);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.45rem;
    font-size: 12px;
    color: var(--n-6);
    font-variant-numeric: tabular-nums;
  }
  .kind {
    padding: 0 0.45rem;
    border-radius: 4px;
    color: var(--accent);
    background: var(--accent-soft);
    font-size: 11.5px;
    line-height: 1.7;
  }
  .entry-arrow {
    color: var(--n-5);
    font-size: 16px;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s, transform 0.35s var(--ease-out), color 0.2s;
  }
  .entry:hover .entry-arrow {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }
</style>
