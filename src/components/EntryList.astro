---
import { dotDate, readingMinutes } from '../utils/content';

export interface Item {
  href: string;
  title: string;
  date: Date;
  description?: string;
  kind?: 'post' | 'note';
  body?: string;
  tags?: string[];
}
interface Props {
  items: Item[];
  showKind?: boolean;
  startIndex?: number;
}
const { items, showKind = false, startIndex = 0 } = Astro.props;
---
<ul class="rows">
  {items.map((it, i) => (
    <li class="reveal" style={`--i:${startIndex + i}`}>
      <a href={it.href} class="row">
        <time class="date meta" datetime={it.date.toISOString()}>{dotDate(it.date)}</time>
        <div class="main">
          <h3>{it.title}</h3>
          {it.description && <p class="desc">{it.description}</p>}
          <div class="info meta">
            {showKind && <span class="kind">{it.kind === 'note' ? '手记' : '文章'}</span>}
            {it.kind !== 'note' && it.body && <span>~ {readingMinutes(it.body)} min</span>}
            {it.tags?.slice(0, 3).map((t) => <span>#{t}</span>)}
          </div>
        </div>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hair);
  }
  .rows li {
    border-bottom: 1px solid var(--hair);
  }
  .row {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) 24px;
    gap: 24px;
    align-items: baseline;
    padding: 22px 0;
  }
  .date {
    letter-spacing: 0.04em;
  }
  h3 {
    font-size: 20px;
    line-height: 1.4;
    color: var(--n-10);
    transition: color 0.2s var(--ease);
  }
  .row:hover h3 {
    color: var(--accent);
  }
  .desc {
    margin: 6px 0 0;
    max-width: 60ch;
    font-family: var(--font-serif);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--n-7);
  }
  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 10px;
    font-size: 11.5px;
  }
  .info:empty {
    display: none;
  }
  .kind {
    color: var(--accent);
  }
  .arrow {
    justify-self: end;
    font-size: 14px;
    color: var(--n-5);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.2s var(--ease), transform 0.3s var(--ease), color 0.2s;
  }
  .row:hover .arrow {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 18px 0;
    }
    .arrow {
      display: none;
    }
    h3 {
      font-size: 18px;
    }
  }
</style>
