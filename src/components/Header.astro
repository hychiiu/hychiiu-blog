---
import { site, type Lang } from '../site.config';
import { localizePath, navItems, stripLang } from '../i18n';
import Toolbar from './Toolbar.astro';
interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const path = stripLang(Astro.url.pathname);
const items = navItems(lang);
const isActive = (href: string) => {
  const h = stripLang(href);
  return h === '/' ? path === '/' : path.startsWith(h.replace(/\/$/, ''));
};
---
<header class="topnav" data-header transition:name="topnav" transition:animate="none">
  <div class="shell bar">
    <a href={localizePath(lang, '/')} class="brand" aria-label={site.name}>
      <img src={site.avatar} alt="" width="26" height="26" />
      <span class="name">{site.name}</span>
      {site.nameCJK && <span class="cn">{site.nameCJK}</span>}
    </a>
    <nav class="links" aria-label="Main">
      {items.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="tools">
      <Toolbar lang={lang} alternates={alternates} />
    </div>
  </div>
</header>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .topnav.scrolled {
    background: rgb(var(--paper-rgb) / 0.8);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom-color: var(--hair);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
  }
  .brand img {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .name {
    font-size: 18px;
    font-weight: 500;
    color: var(--n-10);
  }
  .cn {
    font-size: 15px;
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 2px;
  }
  .links a {
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--n-7);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .links a:hover {
    color: var(--n-10);
    background: color-mix(in srgb, var(--n-10) 4%, transparent);
  }
  .links a.active {
    color: var(--n-10);
    background: var(--n-2);
  }
  .tools {
    margin-left: auto;
  }
  /* 宽屏：和 yohaku.innei.dev 一样浮在右上角 */
  @media (min-width: 1360px) {
    .tools {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 60;
    }
  }
  @media (max-width: 640px) {
    .bar {
      flex-wrap: wrap;
      height: auto;
      gap: 6px 12px;
      padding-top: 10px;
      padding-bottom: 8px;
    }
    .cn {
      display: none;
    }
    .links {
      order: 3;
      width: 100%;
      margin-left: -10px;
    }
  }
</style>

<script>
  const onScroll = () => document.querySelector('[data-header]')?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);
</script>
