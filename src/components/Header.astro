---
import { site } from '../site.config';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')));
---
<header class="topnav" data-header>
  <div class="shell bar">
    <a href="/" class="brand" aria-label={`${site.name} 首页`}>
      <span class="name">{site.name}</span>
      {site.nameCJK && <span class="cn">{site.nameCJK}</span>}
    </a>
    <div class="right">
      <nav class="links" aria-label="主导航">
        {site.nav.map((item) => (
          <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <span class="sep" aria-hidden="true"></span>
      <button class="toggle" type="button" data-theme-toggle aria-label="切换深浅色">
        <Icon name="sun" size={15} class="i-sun" />
        <Icon name="moon" size={15} class="i-moon" />
      </button>
    </div>
  </div>
</header>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .topnav.scrolled {
    background: rgb(var(--paper-rgb) / 0.8);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom-color: var(--hair);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-serif);
  }
  .name {
    font-size: 18px;
    font-weight: 500;
    color: var(--n-10);
  }
  .cn {
    font-size: 15px;
    color: var(--accent);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .links {
    display: flex;
    gap: 2px;
  }
  .links a {
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--n-7);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .links a:hover {
    color: var(--n-10);
    background: color-mix(in srgb, var(--n-10) 4%, transparent);
  }
  .links a.active {
    color: var(--n-10);
    background: var(--n-2);
  }
  .sep {
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: var(--border);
  }
  .toggle {
    display: grid;
    place-items: center;
    width: 30px;
    height: 28px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--n-7);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .toggle:hover {
    color: var(--n-10);
    background: var(--n-2);
  }
  .toggle :global(svg) {
    grid-area: 1 / 1;
    transition: opacity 0.25s var(--ease), transform 0.4s var(--ease);
  }
  .toggle :global(.i-moon) {
    opacity: 0;
    transform: rotate(-45deg) scale(0.7);
  }
  :global(:root[data-theme='dark']) .toggle :global(.i-sun) {
    opacity: 0;
    transform: rotate(45deg) scale(0.7);
  }
  :global(:root[data-theme='dark']) .toggle :global(.i-moon) {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 560px) {
    .bar {
      height: 54px;
    }
    .links a {
      padding: 4px 7px;
    }
    .cn {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    root.dataset.theme = next;
    if (next === sys) localStorage.removeItem('theme');
    else localStorage.setItem('theme', next);
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
