---
/**
 * 评论（docs/DESIGN.md §7 评论）
 * - 构建时把 issue 下的评论静态渲染成和文章一致的排版（同步由 GitHub Action 触发）；
 * - 底部胶囊按钮「在 GitHub 上留言 ↗」直接打开 issue；
 * - 「在本页留言」按需加载 utterances（同一个 issue，需在仓库安装 GitHub App，见 config/integrations.ts），
 *   加载成功后它会列出全部评论，此时收起静态列表避免重复。默认不加载：iframe 是 GitHub 风格，和站点不协调，也更省流量。
 */
import { comments as commentsConfig, type Lang } from '../config';
import { useT } from '../i18n';
import { dotDate } from '../utils/content';
import type { EntryComment } from '../utils/issue-schema';

interface Props {
  lang: Lang;
  repo: string;
  number: number;
  url: string;
  locked?: boolean;
  comments: EntryComment[];
}
const { lang, repo, number, url, locked = false, comments } = Astro.props;
const t = useT(lang);
const emoji: Record<string, string> = {
  '+1': '👍',
  '-1': '👎',
  laugh: '😄',
  hooray: '🎉',
  confused: '😕',
  heart: '❤️',
  rocket: '🚀',
  eyes: '👀',
};
const avatar = (u: string) => `${u}${u.includes('?') ? '&' : '?'}s=64`;
const reactionsOf = (r?: Record<string, number>) => Object.entries(r ?? {}).filter(([, n]) => n > 0);
---

<section class="comments" aria-label={t('post.comments')}>
  <h2 class="c-title">
    {t('post.comments')}
    <span class="c-count">{comments.length}</span>
  </h2>

  {comments.length > 0 ? (
    <ol class="c-list" data-static-comments>
      {comments.map((c) => (
        <li class="c" id={`comment-${c.id}`}>
          <a
            class="c-avatar"
            href={c.authorUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={c.author}
            tabindex="-1"
          >
            <img
              src={avatar(c.avatar)}
              alt=""
              width="28"
              height="28"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </a>
          <div class="c-main">
            <div class="c-meta">
              <a class="c-name" href={c.authorUrl} target="_blank" rel="noopener noreferrer">
                {c.author}
              </a>
              {c.association === 'OWNER' && <span class="c-badge">{t('comments.author')}</span>}
              <a class="c-date" href={c.url} target="_blank" rel="noopener noreferrer">
                <time datetime={c.createdAt.toISOString()}>{dotDate(c.createdAt)}</time>
              </a>
            </div>
            <div class="prose c-body" set:html={c.html} />
            {reactionsOf(c.reactions).length > 0 && (
              <div class="c-react">
                {reactionsOf(c.reactions).map(([k, n]) => (
                  <span>
                    {emoji[k] ?? k} {n}
                  </span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <p class="c-empty" data-static-comments>
      {locked ? t('comments.locked') : t('comments.empty')}
    </p>
  )}

  {!locked && (
    <>
      <div class="c-actions">
        <a class="btn btn--ghost" href={url} target="_blank" rel="noopener noreferrer">
          {t('comments.onGitHub')} <span aria-hidden="true">↗</span>
        </a>
        {commentsConfig.utterances.enabled && (
          <button type="button" class="c-inline" data-utterances-load>
            {t('comments.inline')}
          </button>
        )}
      </div>
      {commentsConfig.utterances.enabled && (
        <div class="utterances-slot" data-utterances data-repo={repo} data-issue={number} hidden />
      )}
    </>
  )}
</section>

<style>
  .comments {
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--hair);
  }
  .c-title {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-5);
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--ink-strong);
  }
  .c-count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .c-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .c-list[hidden],
  .c-empty[hidden] {
    display: none;
  }
  .c {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: var(--sp-3);
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--hair);
  }
  .c:first-child {
    padding-top: var(--sp-2);
    border-top: 0;
  }
  .c-avatar img {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: var(--r-round);
    object-fit: cover;
    box-shadow: 0 0 0 0.5px var(--border);
  }
  .c-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    min-height: 28px;
    margin-bottom: var(--sp-1);
    font-size: var(--fs-meta);
  }
  .c-name {
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--ink-strong);
    transition: color var(--dur-2) var(--ease);
  }
  .c-name:hover {
    color: var(--accent);
  }
  .c-badge {
    padding: 0 7px;
    border-radius: var(--r-pill);
    background: var(--accent-8);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    line-height: 1.7;
    color: var(--accent);
  }
  .c-date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-2) var(--ease);
  }
  .c-date:hover {
    color: var(--accent);
  }
  /* 正文沿用文章排版（.prose），缩小一级 */
  .c-body {
    font-size: var(--fs-ui);
    line-height: 1.8;
  }
  .c-body :global(> :first-child) {
    margin-top: 0;
  }
  .c-body :global(> :last-child) {
    margin-bottom: 0;
  }
  .c-body :global(> p:first-of-type::first-letter) {
    float: none;
    font-size: inherit;
    padding: 0;
    color: inherit;
    font-weight: inherit;
  }
  .c-react {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
  .c-react span {
    padding: 2px 9px;
    border: 0.5px solid var(--border);
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-muted);
  }
  .c-empty {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-ui);
    color: var(--ink-faint);
  }
  .c-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
  }
  .c-inline {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    color: var(--ink-muted);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: color var(--dur-2) var(--ease);
  }
  .c-inline:hover {
    color: var(--accent);
  }
  .c-inline[hidden] {
    display: none;
  }
  .utterances-slot {
    margin-top: var(--sp-4);
  }
  .utterances-slot :global(.utterances) {
    max-width: none;
  }
</style>

<script>
  import '../scripts/comments';
</script>
