---
import Base from '../../layouts/Base.astro';
import { getNotes, formatDate } from '../../utils/content';
const notes = await getNotes();
const excerpt = (s = '') => s.replace(/^>.*$/gm, '').replace(/[#*`>\[\]_]/g, '').replace(/\(.*?\)/g, '').replace(/\s+/g, ' ').trim().slice(0, 120);
---
<Base title="手记" description="生活碎片与随手记录">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow reveal" style="--i:0">Notes</p>
      <h1 class="reveal" style="--i:1">手记</h1>
      <p class="reveal" style="--i:2">不成文的碎片，记下当下的心情。</p>
    </header>
    {notes.length === 0 && <p class="muted">还没有手记。</p>}
    <ol class="notes">
      {notes.map((n, i) => (
        <li class="reveal" style={`--i:${i + 3}`}>
          <a href={`/notes/${n.id}/`} class="note">
            <div class="date tabular">
              <span class="d serif">{String(n.data.date.getDate()).padStart(2, '0')}</span>
              <span class="ym">{n.data.date.getFullYear()}.{String(n.data.date.getMonth() + 1).padStart(2, '0')}</span>
            </div>
            <div class="body">
              <h2>{n.data.title}</h2>
              <p>{excerpt(n.body)}…</p>
              <span class="meta">{formatDate(n.data.date)}{n.data.mood && ` · ${n.data.mood}`}{n.data.weather && ` · ${n.data.weather}`}</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .note {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.25rem;
    padding: 1.4rem 1.4rem;
    border-radius: 14px;
    background: var(--n-1);
    box-shadow: 0 0 0 1px var(--border);
    transition: box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  :global(:root[data-theme='dark']) .note {
    background: var(--n-2);
  }
  .note:hover {
    box-shadow: 0 0 0 1px var(--border-strong), var(--shadow-whisper);
    transform: translateY(-2px);
  }
  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-right: 1.25rem;
    border-right: 1px solid var(--border);
  }
  .d {
    font-size: 30px;
    line-height: 1.1;
    color: var(--n-10);
  }
  .ym {
    margin-top: 0.25rem;
    font-size: 11.5px;
    color: var(--n-6);
  }
  h2 {
    font-size: 17px;
    line-height: 1.5;
    transition: color 0.2s;
  }
  .note:hover h2 {
    color: var(--accent);
  }
  .body p {
    margin: 0.4rem 0 0;
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--n-7);
  }
  .meta {
    display: block;
    margin-top: 0.6rem;
    font-size: 12px;
    color: var(--n-6);
  }
  @media (max-width: 560px) {
    .note {
      grid-template-columns: 3.4rem 1fr;
      gap: 1rem;
      padding: 1.1rem;
    }
    .date { padding-right: 1rem; }
  }
</style>
