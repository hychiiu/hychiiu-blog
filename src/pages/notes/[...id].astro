---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getNotes } from '../../utils/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    params: { id: note.id },
    props: {
      note,
      newer: notes[i - 1] ? { href: `/notes/${notes[i - 1].id}/`, title: notes[i - 1].data.title } : undefined,
      older: notes[i + 1] ? { href: `/notes/${notes[i + 1].id}/`, title: notes[i + 1].data.title } : undefined,
    },
  }));
}
const { note, newer, older } = Astro.props;
const { Content } = await render(note);
const extra = [note.data.mood && `心情：${note.data.mood}`, note.data.weather && `天气：${note.data.weather}`].filter(Boolean) as string[];
---
<Article kind="note" title={note.data.title} date={note.data.date} body={note.body} backHref="/notes/" backLabel="手记" extra={extra} prev={older} next={newer}>
  <Content />
</Article>
