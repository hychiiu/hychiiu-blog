---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { entryPaths } from '../../../utils/routes';
import { localizePath, useT } from '../../../i18n';

export const getStaticPaths = () => entryPaths('posts', 'en');
const { entry: post, lang, newer, older, alternates } = Astro.props;
const t = useT(lang);
const { Content } = await render(post);
---

<Article
  kind="post"
  lang={lang}
  contentLang={post.data.lang}
  issue={post.data}
  alternates={alternates}
  title={post.data.title}
  date={post.data.date}
  description={post.data.description}
  tags={post.data.tags}
  body={post.body}
  backHref={localizePath(lang, '/posts/')}
  backLabel={t('nav.posts')}
  prev={older}
  next={newer}
>
  <Content />
</Article>
