---
import Base from '../layouts/Base.astro';
---
<Base title="404" description="页面不存在">
  <div class="shell">
    <header class="nf">
      <p class="eyebrow reveal" style="--i:0"><span class="dot"></span><span>Error · 404 · Not found</span></p>
      <h1 class="reveal" style="--i:1">404<span class="cn-accent">迷途</span></h1>
      <p class="lede reveal" style="--i:2">你要找的页面不存在，或者已经被移走了。这里只剩留白。</p>
      <a href="/" class="btn btn--primary reveal" style="--i:3">← 回到首页</a>
    </header>
  </div>
</Base>

<style>
  .nf {
    padding: 120px 0 40px;
  }
  h1 {
    margin: 24px 0 18px;
    font-size: clamp(72px, 12vw, 128px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  h1 .cn-accent {
    margin-left: 18px;
  }
  .lede {
    margin: 0 0 32px;
    max-width: 40ch;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.55;
    color: var(--n-7);
  }
  @media (max-width: 640px) {
    .nf { padding-top: 64px; }
  }
</style>
