---
import Base from '../../layouts/Base.astro';
import { getPosts, dotDate, readingMinutes } from '../../utils/content';

const posts = await getPosts();
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
let idx = 3;
---
<Base title="文章" description="所有文章">
  <div class="shell">
    <header class="page-hero">
      <p class="eyebrow reveal" style="--i:0"><span class="dot"></span><span>Posts · {posts.length} 篇</span></p>
      <h1 class="reveal" style="--i:1">Posts<span class="cn-accent">文章</span></h1>
      <p class="lede reveal" style="--i:2">写得不多，但每一篇都认真。按年份排列。</p>
    </header>

    {posts.length === 0 && <p class="lede">还没有文章。</p>}

    {[...byYear.entries()].map(([year, list], yi) => (
      <section class="section year-block">
        <div class="section-head reveal" style={`--i:${idx++}`}>
          <p class="section-num">{String(yi).padStart(2, '0')} · {list.length} {list.length > 1 ? 'entries' : 'entry'}</p>
          <h2 class="section-title tabular">{year}</h2>
        </div>
        <ul class="list">
          {list.map((p) => (
            <li class="reveal" style={`--i:${idx++}`}>
              <a href={`/posts/${p.id}/`}>
                <time class="meta" datetime={p.data.date.toISOString()}>{dotDate(p.data.date)}</time>
                <span class="t">{p.data.title}</span>
                <span class="meta right">
                  {p.data.tags.slice(0, 2).map((t) => <span class="tg">#{t}</span>)}
                  <span>~ {readingMinutes(p.body)} min</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hair);
  }
  .list li {
    border-bottom: 1px solid var(--hair);
  }
  .list a {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding: 16px 0;
  }
  .t {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.45;
    color: var(--n-10);
    transition: color 0.2s var(--ease);
  }
  .list a:hover .t {
    color: var(--accent);
  }
  .right {
    display: flex;
    gap: 12px;
    font-size: 11.5px;
  }
  .tg {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .list a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
