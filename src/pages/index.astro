---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EntryList, { type Item } from '../components/EntryList.astro';
import { site } from '../site.config';
import { getPosts, getNotes, getStats } from '../utils/content';

const [posts, notes, stats] = await Promise.all([getPosts(), getNotes(), getStats()]);
const recent: Item[] = [
  ...posts.map((p) => ({ href: `/posts/${p.id}/`, title: p.data.title, date: p.data.date, description: p.data.description, kind: 'post' as const, body: p.body, tags: p.data.tags })),
  ...notes.map((n) => ({ href: `/notes/${n.id}/`, title: n.data.title, date: n.data.date, kind: 'note' as const })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 6);

const fmtWords = (w: number) => (w >= 1000 ? `${(w / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(w));
const since = site.startDate.replaceAll('-', '.').slice(0, 7);
const ghUser = site.socials.find((s) => s.icon === 'github')?.href.split('/').filter(Boolean).pop();
---
<Base>
  <div class="shell">
    <header class="hero">
      <div class="hero-main">
        <p class="eyebrow reveal" style="--i:0"><span class="dot"></span><span>{site.eyebrow} · since {since}</span></p>
        <h1 class="title reveal" style="--i:1">
          <span class="greet">{site.greeting}</span>
          <span class="nm">{site.name}{site.nameCJK && <span class="cn-accent cn">{site.nameCJK}</span>}</span>
        </h1>
        <p class="tagline reveal" style="--i:2">{site.intro}{site.wave && <span class="wave" aria-hidden="true"> {site.wave}</span>}</p>
        {site.subIntro && <p class="tagline sub reveal" style="--i:3">{site.subIntro}</p>}

        <div class="tokens reveal" style="--i:4">
          <span><b>Posts</b>{stats.posts}</span>
          <span><b>Notes</b>{stats.notes}</span>
          <span><b>Words</b>{fmtWords(stats.words)}</span>
          <span><b>Days</b><i data-days data-start={site.startDate}>{stats.days}</i></span>
          {ghUser && <span><b>GitHub</b>@{ghUser}</span>}
        </div>
      </div>

      <figure class="avatar reveal" style="--i:2">
        <img src={site.avatarLarge} alt={`${site.name} 的头像`} width="168" height="168" loading="eager" />
        <figcaption class="meta">{site.name}{site.nameCJK && <span class="cn-accent"> · {site.nameCJK}</span>}</figcaption>
      </figure>
    </header>

    <section class="section">
      <div class="section-head reveal" style="--i:5">
        <p class="section-num">00 · Writing</p>
        <h2 class="section-title">最近在写</h2>
        <p class="section-lede">{site.recentLede}</p>
      </div>
      {recent.length ? <EntryList items={recent} showKind startIndex={6} /> : <p class="section-lede">还没有内容，敬请期待。</p>}
      <a href="/posts/" class="all btn btn--primary reveal" style={`--i:${6 + recent.length}`}>全部文章 <Icon name="arrow" size={14} /></a>
    </section>

    <section class="section">
      <div class="section-head reveal" style={`--i:${7 + recent.length}`}>
        <p class="section-num">01 · Quote</p>
        <blockquote class="quote">「{site.quote}」{site.quoteAuthor && <cite>{site.quoteAuthor}</cite>}</blockquote>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <p class="section-num">02 · Elsewhere</p>
        <h2 class="section-title">在别处</h2>
      </div>
      <ul class="socials">
        {site.socials.map((s) => (
          <li>
            <a class="icon-btn social" href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <Icon name={s.icon} size={16} />
              <span>{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: start;
    padding: 72px 0 48px;
    margin-bottom: 72px;
    border-bottom: 1px solid var(--border);
  }
  .title {
    margin: 24px 0 26px;
    font-size: clamp(56px, 9vw, 112px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--n-10);
  }
  .greet {
    display: block;
    margin-bottom: 0.12em;
    font-size: 0.44em;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--n-7);
  }
  .nm {
    display: block;
    white-space: nowrap;
  }
  .cn {
    display: inline-block;
    margin-left: 18px;
  }
  .tagline {
    margin: 0;
    max-width: 40ch;
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.5;
    color: var(--n-7);
  }
  .tagline.sub {
    margin-top: 6px;
    font-size: 16px;
  }
  .wave {
    font-family: var(--font-sans);
  }
  .tokens {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--n-7);
    font-variant-numeric: tabular-nums;
  }
  .tokens span {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
  }
  .tokens b {
    font-weight: 500;
    color: var(--n-9);
  }
  .tokens i {
    font-style: normal;
  }
  .avatar {
    margin: 52px 0 0;
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .avatar img {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    padding: 5px;
    background: var(--paper);
  }
  .avatar figcaption {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .all {
    margin-top: 28px;
  }
  .quote {
    margin: 10px 0 0;
    max-width: 30ch;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.5;
    color: var(--n-10);
  }
  .quote cite {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 12px;
    color: var(--n-7);
  }
  .socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
  }
  .social {
    padding: 8px 14px 8px 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    color: var(--n-9);
  }
  .social:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 40px 0 36px;
      margin-bottom: 56px;
    }
    .nm {
      white-space: normal;
    }
    .avatar {
      grid-row: 1;
      margin: 0 0 28px;
      justify-items: start;
    }
    .avatar img {
      width: 84px;
      height: 84px;
      padding: 3px;
    }
    .avatar figcaption {
      display: none;
    }
    .title {
      margin: 16px 0 14px;
      font-size: clamp(48px, 15vw, 80px);
    }
    .tagline {
      font-size: 18px;
    }
    .tokens {
      font-size: 12px;
      gap: 8px 16px;
    }
    .quote {
      font-size: 22px;
    }
  }
  @media (max-width: 480px) {
    .cn {
      display: block;
      margin: 6px 0 0;
      font-size: 0.6em;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-days]');
  if (el?.dataset.start) {
    const d = Math.floor((Date.now() - new Date(el.dataset.start).getTime()) / 86400000) + 1;
    if (d > 0) el.textContent = String(d);
  }
</script>
