---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EntryList, { type Item } from '../components/EntryList.astro';
import { site } from '../site.config';
import { getPosts, getNotes, getStats } from '../utils/content';

const [posts, notes, stats] = await Promise.all([getPosts(), getNotes(), getStats()]);
const recent: Item[] = [
  ...posts.map((p) => ({ href: `/posts/${p.id}/`, title: p.data.title, date: p.data.date, description: p.data.description, kind: 'post' as const, body: p.body })),
  ...notes.map((n) => ({ href: `/notes/${n.id}/`, title: n.data.title, date: n.data.date, kind: 'note' as const })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 6);

const fmtWords = (w: number) => (w >= 1000 ? `${(w / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(w));
---
<Base>
  <section class="hero container container-wide">
    <div class="glow" aria-hidden="true"></div>
    <div class="hero-text">
      <h1 class="greeting reveal" style="--i:0">
        {site.greeting} <span class="name">{site.name}</span> <span class="wave" aria-hidden="true">{site.wave}</span>
      </h1>
      <p class="intro reveal" style="--i:1">{site.intro}</p>
      {site.subIntro && <p class="sub-intro reveal" style="--i:2">{site.subIntro}</p>}

      <ul class="socials reveal" style="--i:3" aria-label="社交链接">
        {site.socials.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} title={s.label} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-avatar reveal" style="--i:1">
      <div class="avatar-ring">
        <img src={site.avatarLarge} alt={`${site.name} 的头像`} width="256" height="256" loading="eager" />
      </div>
    </div>
  </section>

  <section class="container container-wide meta-row">
    <blockquote class="quote reveal" style="--i:4">
      <span class="qm">「</span>{site.quote}<span class="qm">」</span>
      {site.quoteAuthor && <cite>{site.quoteAuthor}</cite>}
    </blockquote>

    <p class="stats reveal tabular" style="--i:5">
      <span><b>{stats.posts}</b> 篇文章</span>
      <span class="sep">·</span>
      <span><b>{fmtWords(stats.words)}</b> 字</span>
      <span class="sep">·</span>
      <span><b data-days data-start={site.startDate}>{stats.days}</b> 天</span>
    </p>
  </section>

  <section class="container container-wide recent">
    <div class="section-head reveal" style="--i:6">
      <h2>最近在写</h2>
      <a href="/posts/" class="more">全部文章 <Icon name="arrow" size={14} /></a>
    </div>
    {recent.length ? <EntryList items={recent} showKind startIndex={7} /> : <p class="muted">还没有内容，敬请期待。</p>}
  </section>
</Base>

<style>
  .glow {
    position: absolute;
    top: -9rem;
    left: 50%;
    width: 100vw;
    height: 42rem;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(ellipse 34rem 17rem at calc(50% + 17rem) 50%, color-mix(in oklab, var(--accent) 10%, transparent), transparent),
      radial-gradient(ellipse 26rem 14rem at calc(50% - 20rem) 38%, color-mix(in oklab, var(--accent) 5%, transparent), transparent);
  }
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 3rem;
    padding-top: 7rem;
    padding-bottom: 3.5rem;
  }
  .greeting {
    font-size: 48px;
    line-height: 1.17;
    letter-spacing: -0.005em;
    color: var(--n-10);
  }
  .name {
    position: relative;
    white-space: nowrap;
  }
  .name::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: 0.08em;
    height: 0.32em;
    border-radius: 2px;
    background: var(--accent-soft);
    z-index: -1;
  }
  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.4s ease-in-out 1.2s 2;
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0); }
    10%, 30% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }
  .intro {
    margin: 1.5rem 0 0;
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.6;
    color: var(--n-9);
  }
  .sub-intro {
    margin: 0.6rem 0 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--n-7);
    max-width: 34em;
  }
  .socials {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: var(--n-7);
    background: var(--n-2);
    box-shadow: 0 0 0 1px var(--border);
    transition: color 0.2s, background 0.2s, transform 0.35s var(--ease-out);
  }
  .socials a:hover {
    color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }
  .hero-avatar {
    justify-self: end;
  }
  .avatar-ring {
    position: relative;
    width: 208px;
    height: 208px;
    padding: 6px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--border-strong), 0 20px 50px -24px rgb(36 35 31 / 0.35);
  }
  .avatar-ring::before {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: 999px;
    border: 1px dashed var(--border-strong);
    animation: spin 60s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .avatar-ring img {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    object-fit: cover;
    display: block;
  }

  .meta-row {
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--border);
  }
  .quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.8;
    color: var(--n-7);
  }
  .qm {
    color: var(--n-6);
  }
  .quote cite {
    margin-left: 0.75rem;
    font-style: normal;
    font-size: 13px;
    color: var(--n-6);
  }
  .stats {
    margin: 1rem 0 0;
    font-size: 13px;
    color: var(--n-7);
  }
  .stats b {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15px;
    color: var(--n-10);
    margin-right: 0.15rem;
  }
  .stats .sep {
    margin: 0 0.6rem;
    color: var(--n-5);
  }

  .recent {
    padding-top: 3.5rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .section-head h2 {
    font-size: 22px;
    line-height: 1.4;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 13px;
    color: var(--n-7);
    transition: color 0.2s, gap 0.3s var(--ease-out);
  }
  .more:hover {
    color: var(--accent);
    gap: 0.5rem;
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 3.5rem;
      padding-bottom: 2.5rem;
    }
    .hero-avatar {
      grid-row: 1;
      justify-self: start;
    }
    .avatar-ring {
      width: 104px;
      height: 104px;
      padding: 4px;
    }
    .avatar-ring::before {
      inset: -9px;
    }
    .greeting {
      font-size: 34px;
    }
    .intro {
      font-size: 18px;
      margin-top: 1.1rem;
    }
    .meta-row {
      padding-bottom: 2.5rem;
    }
    .recent {
      padding-top: 2.5rem;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-days]');
  if (el?.dataset.start) {
    const d = Math.floor((Date.now() - new Date(el.dataset.start).getTime()) / 86400000) + 1;
    if (d > 0) el.textContent = String(d);
  }
</script>
