---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
---
<Base title="关于" description={`关于 ${site.name}`}>
  <div class="shell">
    <header class="page-hero">
      <p class="eyebrow reveal" style="--i:0"><span class="dot"></span><span>About · {site.name}</span></p>
      <h1 class="reveal" style="--i:1">About<span class="cn-accent">关于</span></h1>
      <p class="lede reveal" style="--i:2">{site.intro}</p>
    </header>

    <div class="about">
      <aside class="card reveal" style="--i:3">
        <img src={site.avatarLarge} alt={site.name} width="72" height="72" />
        <div class="who">{site.name}{site.nameCJK && <span class="cn-accent"> {site.nameCJK}</span>}</div>
        <dl class="kv meta">
          <div><dt>Since</dt><dd>{site.startDate.replaceAll('-', '·')}</dd></div>
          {site.socials.map((s) => (
            <div><dt>{s.label}</dt><dd><a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer"><Icon name={s.icon} size={12} /> {s.href.replace(/^https?:\/\//, '').replace(/^mailto:/, '')}</a></dd></div>
          ))}
        </dl>
      </aside>

      <!-- TODO：在这里写下你的自我介绍。直接编辑 src/pages/about.astro 即可。 -->
      <div class="prose reveal" style="--i:4">
        <p>你好，我是 {site.name}。这里是关于页面的占位文字，之后可以改成你自己的故事。</p>
        <p>可以写写你在做什么、喜欢什么、相信什么；也可以只留一句话，让<em>留白</em>替你说完剩下的。</p>
        <h2>现在</h2>
        <ul>
          <li>正在做的事情：占位</li>
          <li>最近在读 / 在听：占位</li>
          <li>常用工具：占位</li>
        </ul>
        <h2>关于本站</h2>
        <p>本站使用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，纯静态托管于 Cloudflare Pages；视觉语言参考了开源的 Yohaku 设计系统（MIT）。</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 260px;
    gap: 64px;
    align-items: start;
  }
  .card {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 88px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .card img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .who {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 20px;
    color: var(--n-10);
  }
  .kv {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--hair);
    display: grid;
    gap: 8px;
    font-size: 11.5px;
  }
  .kv div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .kv dt {
    color: var(--n-9);
    font-weight: 500;
  }
  .kv dd {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kv a {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }
  .kv a:hover {
    color: var(--accent);
  }
  .prose {
    grid-column: 1;
    grid-row: 1;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .card {
      grid-column: 1;
      position: static;
    }
    .prose {
      grid-row: 2;
    }
  }
</style>
