---
/**
 * 单个标签页 = 按标签筛选后的文章列表：与文章列表同一页头（eyebrow / lede 带上标签名）、
 * 同一筛选行（当前标签高亮）+ 按年份分组的文章与手记。切换筛选时页头与筛选行不动，只有列表淡入。
 */
import Base from '../layouts/Base.astro';
import ListHero from '../components/ListHero.astro';
import TagFilter from '../components/TagFilter.astro';
import YearList from '../components/YearList.astro';
import type { Lang } from '../config';
import { useT } from '../i18n';
import { getPostsFor } from '../utils/content';
import { getTagsFor, type Tag } from '../utils/tags';

interface Props {
  lang: Lang;
  tag: Tag;
  alternates: Record<Lang, string>;
}
const { lang, tag, alternates } = Astro.props;
const t = useT(lang);
const [tags, posts] = await Promise.all([getTagsFor(lang), getPostsFor(lang)]);
const mixed = tag.entries.some((e) => e.kind === 'notes');
---

<Base title={`#${tag.name}`} description={t('tag.lede')(tag.name)} alternates={alternates}>
  <div class="shell">
    <ListHero
      eyebrow={t('tag.eyebrow')(tag.name, tag.entries.length)}
      title={t('posts.title')}
      cn={t('posts.cn')}
      lede={t('tag.lede')(tag.name)}
    />

    <TagFilter lang={lang} tags={tags} total={posts.length} active={tag.slug} class="reveal" style="--i:3" />

    <YearList entries={tag.entries} lang={lang} startIndex={4} showKind={mixed} />
  </div>
</Base>
