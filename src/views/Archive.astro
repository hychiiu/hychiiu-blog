---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import YearList from '../components/YearList.astro';
import type { Lang } from '../config';
import { useT } from '../i18n';
import { getPostsFor, getNotesFor } from '../utils/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const [ap, an] = await Promise.all([getPostsFor(lang, 'archived'), getNotesFor(lang, 'archived')]);
const posts = [
  ...ap.map((p) => ({ ...p, kind: 'posts' as const })),
  ...an.map((n) => ({ ...n, kind: 'notes' as const })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={t('nav.archive')} description={t('archive.lede')}>
  <div class="shell">
    <header class="page-hero">
      <p class="eyebrow reveal" style="--i:0">
        <span class="dot"></span>
        <span>
          {t('archive.title')} · {posts.length}
        </span>
      </p>
      <h1 class="reveal" style="--i:1">
        {t('archive.title')}
        <span class="cn-accent">{t('archive.cn')}</span>
      </h1>
      <p class="lede reveal" style="--i:2">
        {t('archive.lede')}
      </p>
    </header>

    {posts.length === 0 && <EmptyState text={t('archive.empty')} class="reveal" style="--i:3" />}

    <YearList entries={posts} lang={lang} showKind showMinutes={false} thumbs={false} />
  </div>
</Base>
