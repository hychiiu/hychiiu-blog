---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import { titleTransition } from '../utils/transitions';
import type { Lang } from '../site.config';
import { useT, localizePath } from '../i18n';
import { getPostsFor, dotDate, readingMinutes } from '../utils/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const posts = await getPostsFor(lang);
const mark = (l: Lang) => (l !== lang ? (l === 'zh' ? t('marker.zh') : t('marker.en')) : undefined);
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
let idx = 3;
---
<Base title={t('nav.posts')} description={t('posts.lede')}>
  <div class="shell">
    <header class="page-hero">
      <p class="eyebrow reveal" style="--i:0"><span class="dot"></span><span>{t('posts.eyebrow')(posts.length)}</span></p>
      <h1 class="reveal" style="--i:1">{t('posts.title')}<span class="cn-accent">{t('posts.cn')}</span></h1>
      <p class="lede reveal" style="--i:2">{t('posts.lede')}</p>
    </header>

    {posts.length === 0 && <EmptyState text={t('posts.empty')} class="reveal" style="--i:3" />}

    {[...byYear.entries()].map(([year, list], yi) => (
      <section class="section year-block">
        <div class="section-head reveal" style={`--i:${idx++}`}>
          <p class="section-num">{String(yi).padStart(2, '0')} · {t('posts.entries')(list.length)}</p>
          <h2 class="section-title tabular">{year}</h2>
        </div>
        <ul class="list">
          {list.map((p) => (
            <li class="reveal" style={`--i:${idx++}`}>
              <a href={localizePath(lang, `/posts/${p.id}/`)}>
                <time class="meta" datetime={p.data.date.toISOString()}>{dotDate(p.data.date)}</time>
                <span class="t vt-title" transition:name={titleTransition(localizePath(lang, `/posts/${p.id}/`))}>{p.data.title}</span>
                <span class="meta right">
                  {mark(p.data.lang) && <span class="marker">{mark(p.data.lang)}</span>}
                  {p.data.tags.slice(0, 2).map((tag) => <span class="tg">#{tag}</span>)}
                  <span>{t('post.min')(readingMinutes(p.body))}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hair);
  }
  .list li {
    border-bottom: 1px solid var(--hair);
  }
  .list a {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding: 16px 0;
  }
  .t {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.45;
    color: var(--n-10);
    transition: color 0.2s var(--ease);
  }
  .list a:hover .t {
    color: var(--accent);
  }
  .right {
    display: flex;
    gap: 12px;
    font-size: 11.5px;
  }
  .marker {
    padding: 0 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 10.5px;
  }
  .tg {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .list a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
