---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import TagFilter from '../components/TagFilter.astro';
import YearList from '../components/YearList.astro';
import type { Lang } from '../config';
import { useT, localizePath } from '../i18n';
import { getPostsFor } from '../utils/content';
import { getTagsFor } from '../utils/tags';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const [posts, archived, tags] = await Promise.all([getPostsFor(lang), getPostsFor(lang, 'archived'), getTagsFor(lang)]);
const archivedCount = archived.length;
const entries = posts.map((p) => ({ ...p, kind: 'posts' as const }));
---

<Base title={t('nav.posts')} description={t('posts.lede')}>
  <div class="shell">
    <header class="page-hero">
      <p class="eyebrow reveal" style="--i:0">
        <span class="dot"></span>
        <span>{t('posts.eyebrow')(posts.length)}</span>
      </p>
      <h1 class="reveal" style="--i:1">
        {t('posts.title')}
        <span class="cn-accent">{t('posts.cn')}</span>
      </h1>
      <p class="lede reveal" style="--i:2">
        {t('posts.lede')}
      </p>
    </header>

    <TagFilter lang={lang} tags={tags} total={posts.length} class="reveal" style="--i:3" />

    {posts.length === 0 && <EmptyState text={t('posts.empty')} class="reveal" style="--i:3" />}

    <YearList entries={entries} lang={lang} startIndex={4} />
    {archivedCount > 0 && (
      <p class="to-archive meta">
        <a href={localizePath(lang, '/archive/')}>
          {t('archive.link')} · {archivedCount} →
        </a>
      </p>
    )}
  </div>
</Base>

<style>
  .to-archive {
    margin: 40px 0 0;
  }
  .to-archive a:hover {
    color: var(--accent);
  }
</style>
