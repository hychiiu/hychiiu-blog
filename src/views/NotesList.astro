---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import { titleTransition } from '../utils/transitions';
import type { Lang } from '../site.config';
import { useT, localizePath } from '../i18n';
import { getNotesFor, dotDate } from '../utils/content';

interface Props { lang: Lang }
const archivedCount = (await getNotesFor(Astro.props.lang, 'archived')).length;
const { lang } = Astro.props;
const t = useT(lang);
const notes = await getNotesFor(lang);
const mark = (l: Lang) => (l !== lang ? (l === 'zh' ? t('marker.zh') : t('marker.en')) : undefined);
const excerpt = (s = '') => s.replace(/^>.*$/gm, '').replace(/[#*`>\[\]_]/g, '').replace(/\(.*?\)/g, '').replace(/\s+/g, ' ').trim().slice(0, 110);
---
<Base title={t('nav.notes')} description={t('notes.lede')}>
  <div class="shell">
    <header class="page-hero">
      <p class="eyebrow reveal" style="--i:0"><span class="dot"></span><span>{t('notes.eyebrow')(notes.length)}</span></p>
      <h1 class="reveal" style="--i:1">{t('notes.title')}<span class="cn-accent">{t('notes.cn')}</span></h1>
      <p class="lede reveal" style="--i:2">{t('notes.lede')}</p>
    </header>
    {notes.length === 0 && <EmptyState text={t('notes.empty')} class="reveal" style="--i:3" />}
    <ol class="notes">
      {notes.map((n, i) => (
        <li class="reveal" style={`--i:${i + 3}`}>
          <a href={localizePath(lang, `/notes/${n.id}/`)} class="note">
            <div class="day">
              <span class="d">{String(n.data.date.getDate()).padStart(2, '0')}</span>
              <span class="meta">{n.data.date.getFullYear()}·{String(n.data.date.getMonth() + 1).padStart(2, '0')}</span>
            </div>
            <div>
              <h2 class="vt-title" transition:name={titleTransition(localizePath(lang, `/notes/${n.id}/`))}>{n.data.title}</h2>
              <p>{excerpt(n.body)}…</p>
              <div class="meta info">
                <span>{dotDate(n.data.date)}</span>
                {mark(n.data.lang) && <span class="marker">{mark(n.data.lang)}</span>}
                {n.data.mood && <span>{t('notes.mood')} {n.data.mood}</span>}
                {n.data.weather && <span>{t('notes.weather')} {n.data.weather}</span>}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ol>
    {archivedCount > 0 && (
      <p class="to-archive meta"><a href={localizePath(lang, '/archive/')}>{t('archive.link')} · {archivedCount} →</a></p>
    )}
  </div>
</Base>

<style>
  .to-archive {
    margin: 40px 0 0;
  }
  .to-archive a:hover {
    color: var(--accent);
  }
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 880px;
  }
  .notes li:first-child .note {
    padding-top: 0;
  }
  .notes li {
    border-bottom: 1px solid var(--hair);
  }
  .note {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
  }
  .day {
    display: grid;
    align-content: start;
    gap: 4px;
  }
  .d {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-4xl);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  h2 {
    font-size: var(--fs-xl);
    line-height: 1.4;
    transition: color var(--dur-2) var(--ease);
  }
  .note:hover h2 {
    color: var(--accent);
  }
  .note p {
    margin: 8px 0 0;
    max-width: 60ch;
    font-family: var(--font-serif);
    font-size: var(--fs-ui);
    line-height: 1.8;
    color: var(--n-7);
  }
  .marker {
    padding: 0 6px;
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    font-size: var(--fs-2xs);
  }
  .info {
    display: flex;
    gap: 14px;
    margin-top: 12px;
    font-size: var(--fs-xs);
  }
  @media (max-width: 640px) {
    .note {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 16px;
      padding: 22px 0;
    }
    .d {
      font-size: var(--fs-3xl);
    }
    .day .meta {
      font-size: var(--fs-2xs);
    }
  }
</style>
