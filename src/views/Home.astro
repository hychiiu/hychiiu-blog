---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EntryList, { type Item } from '../components/EntryList.astro';
import EmptyState from '../components/EmptyState.astro';
import { site, type Lang } from '../site.config';
import { useT, localizePath, quoteMarks } from '../i18n';
import { getPostsFor, getNotesFor, getPosts, getNotes } from '../utils/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const [posts, notes, allPosts, allNotes] = await Promise.all([getPostsFor(lang), getNotesFor(lang), getPosts(), getNotes()]);
const hasArchive = [...allPosts, ...allNotes].some((e) => e.data.archived);
const mark = (l: Lang) => (l !== lang ? (l === 'zh' ? t('marker.zh') : t('marker.en')) : undefined);
const recent: Item[] = [
  ...posts.map((p) => ({ href: localizePath(lang, `/posts/${p.id}/`), marker: mark(p.data.lang), title: p.data.title, date: p.data.date, description: p.data.description, kind: 'post' as const, body: p.body, tags: p.data.tags, cover: p.data.cover })),
  ...notes.map((n) => ({ href: localizePath(lang, `/notes/${n.id}/`), marker: mark(n.data.lang), title: n.data.title, date: n.data.date, kind: 'note' as const, cover: n.data.cover })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 6);

const since = site.startDate.replaceAll('-', '.').slice(0, 7);
const hasQuote = Boolean(site.quote[lang]);
const secNum = (i: number, label: string) => `${String(i).padStart(2, '0')} · ${label}`;
const socials = site.social.map((s) => (s.icon === 'rss' ? { ...s, href: localizePath(lang, '/rss.xml') } : s));
---
<Base>
  <div class="shell">
    <header class="hero">
      <div class="hero-main">
        <p class="eyebrow reveal" style="--i:0"><span class="dot"></span><span>{site.eyebrow[lang]} · {t('home.since')} {since}</span></p>
        <h1 class="title reveal" style="--i:1">
          <span class="greet">{site.greeting[lang]}</span>
          <span class="nm">{site.name}{site.nameCJK && <span class="cn-accent cn">{site.nameCJK}</span>}</span>
        </h1>
        {site.intro[lang] && <p class="tagline reveal" style="--i:2">{site.intro[lang]}{site.wave && <span class="wave" aria-hidden="true"> {site.wave}</span>}</p>}
        {site.subIntro[lang] && <p class="tagline sub reveal" style="--i:3">{site.subIntro[lang]}</p>}

        <ul class="social reveal" style="--i:4" aria-label={t('sec.elsewhereTitle')}>
          {socials.map((s) => {
            const ext = /^https?:/.test(s.href);
            return (
              <li>
                <a href={s.href} aria-label={s.label} data-tip={s.label} target={ext ? '_blank' : undefined} rel={ext ? 'noopener noreferrer me' : undefined}>
                  <Icon name={s.icon} size={18} />
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <figure class="avatar reveal" style="--i:2">
        <img src={site.avatarLarge} alt={t('avatar.alt')(site.name)} width="168" height="168" loading="eager" />
        <figcaption class="meta">@{site.name}{site.nameCJK && <span class="cn-accent"> · {site.nameCJK}</span>}</figcaption>
      </figure>
    </header>

    <section class="section">
      <div class="section-head reveal" style="--i:5">
        <p class="section-num">{secNum(0, t('sec.writing'))}</p>
        <h2 class="section-title">{t('sec.writingTitle')}</h2>
        {site.recentLede[lang] && <p class="section-lede">{site.recentLede[lang]}</p>}
      </div>
      {recent.length ? (
        <>
          <EntryList items={recent} showKind startIndex={6} lang={lang} />
          <div class="more reveal" style={`--i:${6 + recent.length}`}>
            <a href={localizePath(lang, '/posts/')} class="btn btn--primary">{t('btn.allPosts')} <Icon name="arrow" size={14} /></a>
            {hasArchive && <a href={localizePath(lang, '/archive/')} class="archive-link">{t('archive.link')} →</a>}
          </div>
        </>
      ) : (
        <EmptyState text={t('home.empty')} class="reveal" style="--i:6" />
      )}
    </section>

    {hasQuote && (
      <section class="section">
        <div class="section-head reveal" style={`--i:${7 + recent.length}`}>
          <p class="section-num">{secNum(1, t('sec.quote'))}</p>
          <blockquote class="quote">{quoteMarks(lang, site.quote[lang])}{site.quoteAuthor[lang] && <cite>{site.quoteAuthor[lang]}</cite>}</blockquote>
        </div>
      </section>
    )}

  </div>
</Base>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 30px 0 0 -9px;
    padding: 0;
    list-style: none;
  }
  .social a {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-round);
    color: var(--n-6);
    transition: color var(--dur-2) var(--ease), background-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }
  .social a:hover,
  .social a:focus-visible {
    color: var(--accent);
    background: var(--accent-8);
  }
  .social a:active {
    transform: scale(0.92);
  }
  .social a::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    padding: 3px 10px 4px;
    border-radius: var(--r-pill);
    border: 0.5px solid var(--border);
    background: var(--paper);
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.25);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--n-8);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-3) var(--ease);
  }
  .social a:hover::after,
  .social a:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .more {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
  }
  .archive-link {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--n-6);
    transition: color var(--dur-2) var(--ease);
  }
  .archive-link:hover {
    color: var(--accent);
  }
  @media (hover: none) {
    .social a::after {
      display: none;
    }
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: start;
    padding: 72px 0 48px;
    margin-bottom: 72px;
    border-bottom: 1px solid var(--border);
  }
  .title {
    margin: 24px 0 26px;
    font-size: clamp(56px, 9vw, 112px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--n-10);
  }
  .greet {
    display: block;
    margin-bottom: 0.12em;
    font-size: 0.44em;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--n-7);
  }
  .nm {
    display: block;
    white-space: nowrap;
  }
  .cn {
    display: inline-block;
    margin-left: 18px;
  }
  .tagline {
    margin: 0;
    max-width: 30em;
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    line-height: 1.5;
    color: var(--n-7);
  }
  .tagline.sub {
    margin-top: 6px;
    font-size: var(--fs-body);
  }
  .wave {
    font-family: var(--font-sans);
  }
  .avatar {
    margin: 52px 0 0;
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .avatar img {
    width: 168px;
    height: 168px;
    border-radius: var(--r-round);
    object-fit: cover;
    border: 1px solid var(--border);
    padding: 5px;
    background: var(--paper);
  }
  .avatar figcaption {
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
  }
  .quote {
    margin: 10px 0 0;
    max-width: 30ch;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-2xl);
    line-height: 1.5;
    color: var(--n-10);
  }
  .quote cite {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--fs-sm);
    color: var(--n-7);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 40px 0 36px;
      margin-bottom: 56px;
    }
    .nm {
      white-space: normal;
    }
    .avatar {
      grid-row: 1;
      margin: 0 0 28px;
      justify-items: start;
    }
    .avatar img {
      width: 84px;
      height: 84px;
      padding: 3px;
    }
    .avatar figcaption {
      display: none;
    }
    .title {
      margin: 16px 0 14px;
      font-size: clamp(48px, 15vw, 80px);
    }
    .tagline {
      font-size: var(--fs-lg);
    }
    .quote {
      font-size: var(--fs-xl);
    }
  }
  @media (max-width: 480px) {
    .cn {
      display: block;
      margin: 6px 0 0;
      font-size: 0.6em;
    }
  }
</style>

