---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, type Lang } from '../site.config';
import { useT, localizePath } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const about = site.about[lang];
const socials = site.social.map((s) => (s.icon === 'rss' ? { ...s, href: localizePath(lang, '/rss.xml') } : s));
---

<Base title={t('nav.about')} description={site.intro[lang] || undefined}>
  <div class="shell">
    <header class="page-hero">
      <p class="eyebrow reveal" style="--i:0">
        <span class="dot"></span>
        <span>
          {t('about.title')} · {site.name}
        </span>
      </p>
      <h1 class="reveal" style="--i:1">
        {t('about.title')}
        <span class="cn-accent">{t('about.cn')}</span>
      </h1>
      {site.intro[lang] && (
        <p class="lede reveal" style="--i:2">
          {site.intro[lang]}
        </p>
      )}
    </header>

    <div class="about">
      <aside class="card reveal" style="--i:3">
        <img src={site.avatarLarge} alt={t('avatar.alt')(site.name)} width="72" height="72" />
        <div class="who">
          {site.name}
          {site.nameCJK && <span class="cn-accent"> {site.nameCJK}</span>}
        </div>
        <dl class="kv meta">
          <div>
            <dt>{t('about.since')}</dt>
            <dd>{site.startDate.replaceAll('-', '·')}</dd>
          </div>
          {socials.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>
                <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                  <Icon name={s.icon} size={12} /> {s.href.replace(/^https?:\/\//, '').replace(/^mailto:/, '')}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </aside>

      <!-- 关于页正文在 src/site.config.ts 的 about 字段里（中英文各一份） -->
      <div class="prose no-dropcap reveal" style="--i:4">
        {about.paragraphs.map((para) => (
          <p set:html={para} />
        ))}
        {about.now.length > 0 && (
          <>
            <h2>{t('about.now')}</h2>
            <ul>
              {about.now.map((li) => (
                <li set:html={li} />
              ))}
            </ul>
          </>
        )}
        <h2>{t('about.colophon')}</h2>
        <p set:html={about.colophon} />
      </div>
    </div>
  </div>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 260px;
    gap: 64px;
    align-items: start;
  }
  .card {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 88px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }
  .card img {
    width: 72px;
    height: 72px;
    border-radius: var(--r-round);
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .who {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-xl);
    color: var(--n-10);
  }
  .kv {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--hair);
    display: grid;
    gap: 8px;
    font-size: var(--fs-xs);
  }
  .kv div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .kv dt {
    color: var(--n-9);
    font-weight: 500;
  }
  .kv dd {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kv a {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }
  .kv a:hover {
    color: var(--accent);
  }
  .prose {
    grid-column: 1;
    grid-row: 1;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .card {
      grid-column: 1;
      position: static;
    }
    .prose {
      grid-row: 2;
    }
  }
</style>
