---
import Base from './Base.astro';
import Giscus from '../components/Giscus.astro';
import { site } from '../site.config';
import { dotDate, readingMinutes, countWords } from '../utils/content';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  body?: string;
  kind: 'post' | 'note';
  backHref: string;
  backLabel: string;
  extra?: string[];
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}
const { title, date, description, tags = [], body = '', kind, backHref, backLabel, extra = [], prev, next } = Astro.props;
const label = kind === 'note' ? '手记' : tags[0] ?? '文章';
---
<Base title={title} description={description || title} type="article">
  <div class="shell">
    <article class="post">
      <div class="post-meta reveal" style="--i:0">
        <a href={backHref} class="accent">{label}</a>
        <time datetime={date.toISOString()}>{dotDate(date)}</time>
        <span>~ {readingMinutes(body)} min</span>
        <span>{countWords(body)} 字</span>
      </div>
      <h1 class="post-title reveal" style="--i:1">{title}</h1>
      {description && <p class="post-subtitle reveal" style="--i:2">{description}</p>}

      <div class="post-author reveal" style="--i:3">
        <img src={site.avatar} alt="" width="36" height="36" />
        <div>
          <div class="author-name">{site.name}</div>
          <div class="author-date">{dotDate(date)}{extra.map((e) => ` · ${e}`)}</div>
        </div>
      </div>

      <div class="prose reveal" style="--i:4">
        <slot />
      </div>

      <footer class="post-footer">
        <div class="tags">
          {tags.map((t) => <span class="tag">#{t}</span>)}
          {tags.length === 0 && <a class="back" href={backHref}>← {backLabel}</a>}
        </div>
        <span>{countWords(body)} 字 · {dotDate(date)}</span>
      </footer>

      {(prev || next) && (
        <nav class="pager" aria-label="上一篇 / 下一篇">
          {prev ? <a href={prev.href}><span class="meta">← 上一篇</span><span class="pg">{prev.title}</span></a> : <span />}
          {next ? <a href={next.href} class="r"><span class="meta">下一篇 →</span><span class="pg">{next.title}</span></a> : <span />}
        </nav>
      )}

      <Giscus />
    </article>
  </div>
</Base>

<style>
  .post {
    max-width: var(--measure);
    padding-top: 72px;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--n-7);
  }
  .accent {
    color: var(--accent);
  }
  .post-title {
    margin: 0 0 14px;
    font-size: 44px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .post-subtitle {
    margin: 0 0 28px;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--n-7);
  }
  .post-author {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 20px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--hair);
  }
  .post-author img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }
  .author-name {
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 500;
    color: var(--n-10);
  }
  .author-date {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--n-7);
  }
  .post-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--hair);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--n-7);
  }
  .tags {
    display: flex;
    gap: 12px;
  }
  .tags .tag {
    font-size: 11px;
  }
  .back:hover {
    color: var(--accent);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
  }
  .pager a {
    display: grid;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .pager a:hover {
    border-color: color-mix(in srgb, var(--n-10) 18%, transparent);
    background: color-mix(in srgb, var(--n-10) 2%, transparent);
  }
  .pager .r {
    text-align: right;
  }
  .pg {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15px;
    color: var(--n-10);
  }
  @media (max-width: 640px) {
    .post {
      padding-top: 40px;
    }
    .post-title {
      font-size: 32px;
    }
    .post-subtitle {
      font-size: 15.5px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
