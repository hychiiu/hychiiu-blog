---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import Mermaid from '../components/Mermaid.astro';
import 'katex/dist/katex.min.css';
import '../styles/markdown.css';
import { site, type Lang } from '../site.config';
import { useT, htmlLang } from '../i18n';
import { dotDate, readingMinutes, countWords } from '../utils/content';
import { titleTransition } from '../utils/transitions';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  body?: string;
  kind: 'post' | 'note';
  backHref: string;
  backLabel: string;
  extra?: string[];
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
  lang: Lang;
  /** 正文语言（frontmatter lang） */
  contentLang: Lang;
  alternates?: Partial<Record<Lang, string>>;
  /** 来自 GitHub issue 的元数据（评论、归档状态等） */
  issue?: { number: number; url: string; repo: string; archived: boolean; locked: boolean; updated: Date; comments: any[] };
}
const { title, date, description, tags = [], body = '', kind, backHref, backLabel, extra = [], prev, next, lang, contentLang, alternates, issue } = Astro.props;
const t = useT(lang);
const label = kind === 'note' ? t('kind.note') : tags[0] ?? t('kind.post');
const foreign = contentLang !== lang;
---
<Base title={title} description={description || title} type="article" alternates={alternates}>
  <div class="shell">
    <article class="post">
      <div class="post-meta reveal" style="--i:0">
        <a href={backHref} class="accent">{label}</a>
        <time datetime={date.toISOString()}>{dotDate(date)}</time>
        <span>{t('post.min')(readingMinutes(body))}</span>
        <span>{t('post.words')(countWords(body))}</span>
        {issue?.archived && <span class="marker archived">{t('archive.badge')}</span>}
        {foreign && <span class="marker">{contentLang === 'zh' ? t('marker.zh') : t('marker.en')}</span>}
      </div>
      <h1 class="post-title vt-title" style="--i:1" lang={htmlLang[contentLang]} transition:name={titleTransition(Astro.url.pathname)}>{title}</h1>
      {description && <p class="post-subtitle reveal" style="--i:2" lang={htmlLang[contentLang]}>{description}</p>}
      {foreign && lang === 'en' && <p class="notice meta reveal" style="--i:2">{t('post.fallback')}</p>}

      <div class="post-author reveal" style="--i:3">
        <img src={site.avatar} alt="" width="36" height="36" />
        <div>
          <div class="author-name">{site.name}</div>
          <div class="author-date">{dotDate(date)}{extra.map((e) => ` · ${e}`)}</div>
        </div>
      </div>

      <div class="prose reveal" style="--i:4" lang={htmlLang[contentLang]}>
        <slot />
      </div>

      <footer class="post-footer">
        <div class="tags">
          {tags.map((tag) => <span class="tag">#{tag}</span>)}
          {tags.length === 0 && <a class="back" href={backHref}>← {backLabel}</a>}
        </div>
        <span>{t('post.words')(countWords(body))} · {dotDate(date)}</span>
      </footer>

      {(prev || next) && (
        <nav class="pager" aria-label={`${t('post.prev')} / ${t('post.next')}`}>
          {prev ? <a href={prev.href}><span class="meta">{t('post.prev')}</span><span class="pg">{prev.title}</span></a> : <span />}
          {next ? <a href={next.href} class="r"><span class="meta">{t('post.next')}</span><span class="pg">{next.title}</span></a> : <span />}
        </nav>
      )}

      {issue && <Comments lang={lang} repo={issue.repo} number={issue.number} url={issue.url} locked={issue.locked} comments={issue.comments} />}
      <Mermaid />
    </article>
  </div>
</Base>

<style>
  .post {
    max-width: var(--measure);
    padding-top: 72px;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--n-7);
  }
  .marker {
    padding: 0 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 11px;
  }
  .marker.archived {
    color: var(--n-6);
    border-style: dashed;
  }
  .notice {
    margin: -12px 0 24px;
    padding: 8px 12px;
    border-left: 2px solid var(--accent);
    background: var(--accent-8);
    border-radius: 0 6px 6px 0;
  }
  .accent {
    color: var(--accent);
  }
  .post-title {
    margin: 0 0 14px;
    font-size: 44px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .post-subtitle {
    margin: 0 0 28px;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--n-7);
  }
  .post-author {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 20px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--hair);
  }
  .post-author img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }
  .author-name {
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 500;
    color: var(--n-10);
  }
  .author-date {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--n-7);
  }
  .post-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--hair);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--n-7);
  }
  .tags {
    display: flex;
    gap: 12px;
  }
  .tags .tag {
    font-size: 11px;
  }
  .back:hover {
    color: var(--accent);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
  }
  .pager a {
    display: grid;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .pager a:hover {
    border-color: color-mix(in srgb, var(--n-10) 18%, transparent);
    background: color-mix(in srgb, var(--n-10) 2%, transparent);
  }
  .pager .r {
    text-align: right;
  }
  .pg {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15px;
    color: var(--n-10);
  }
  @media (max-width: 640px) {
    .post {
      padding-top: 40px;
    }
    .post-title {
      font-size: 32px;
    }
    .post-subtitle {
      font-size: 15.5px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
