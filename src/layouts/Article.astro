---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import Mermaid from '../components/Mermaid.astro';
import 'katex/dist/katex.min.css';
import '../styles/markdown.css';
import { site, comments, type Lang } from '../config';
import { useT, htmlLang } from '../i18n';
import { dotDate, readingMinutes, countWords } from '../utils/content';
import { titleTransition } from '../utils/transitions';
import type { EntryData } from '../utils/issue-schema';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  body?: string;
  kind: 'post' | 'note';
  backHref: string;
  backLabel: string;
  extra?: string[];
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
  lang: Lang;
  /** 正文语言（frontmatter lang） */
  contentLang: Lang;
  alternates?: Partial<Record<Lang, string>>;
  /** 来自 GitHub issue 的元数据（评论、归档状态等） */
  issue?: EntryData;
}
const {
  title,
  date,
  description,
  tags = [],
  body = '',
  kind,
  backHref,
  backLabel,
  extra = [],
  prev,
  next,
  lang,
  contentLang,
  alternates,
  issue,
} = Astro.props;
const t = useT(lang);
const label = kind === 'note' ? t('kind.note') : (tags[0] ?? t('kind.post'));
const foreign = contentLang !== lang;
// 本页留言启用时，提前连接 utterances 与 GitHub API（见 config/integrations.ts）
const inlineComments = !!issue && !issue.locked && comments.utterances.mode !== 'off';
---

<Base title={title} description={description || title} type="article" image={issue?.cover} alternates={alternates}>
  {inlineComments &&
    comments.utterances.preconnect.map((href) => <link rel="preconnect" href={href} crossorigin slot="head" />)}
  <div class="shell">
    <article class="post">
      <a class="back-link reveal" style="--i:0" href={backHref} data-back>
        <span aria-hidden="true">←</span> {backLabel}
      </a>
      <div class="post-meta reveal" style="--i:0">
        <a href={backHref} class="accent">
          {label}
        </a>
        <time datetime={date.toISOString()}>{dotDate(date)}</time>
        <span>{t('post.min')(readingMinutes(body))}</span>
        <span>{t('post.words')(countWords(body))}</span>
        {issue?.archived && <span class="badge archived">{t('archive.badge')}</span>}
        {foreign && <span class="badge">{contentLang === 'zh' ? t('marker.zh') : t('marker.en')}</span>}
      </div>
      <h1
        class="post-title vt-title"
        style="--i:1"
        lang={htmlLang[contentLang]}
        transition:name={titleTransition(Astro.url.pathname)}
      >
        {title}
      </h1>
      {description && (
        <p class="post-subtitle reveal" style="--i:2" lang={htmlLang[contentLang]}>
          {description}
        </p>
      )}
      {foreign && lang === 'en' && (
        <p class="notice meta reveal" style="--i:2">
          {t('post.fallback')}
        </p>
      )}

      <div class="post-author reveal" style="--i:3">
        <img src={site.avatar} alt="" width="36" height="36" />
        <div>
          <div class="author-name">{site.name}</div>
          <div class="author-date">
            {dotDate(date)}
            {extra.map((e) => ` · ${e}`)}
          </div>
        </div>
      </div>

      <div class="prose reveal" style="--i:4" lang={htmlLang[contentLang]}>
        <slot />
      </div>

      <footer class="post-footer">
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
        <span>
          {t('post.words')(countWords(body))} · {dotDate(date)}
        </span>
      </footer>

      {(prev || next) && (
        <nav class="pager" aria-label={`${t('post.prev')} / ${t('post.next')}`}>
          {prev ? (
            <a href={prev.href} rel="prev">
              <span class="pg-label">{t('post.prev')}</span>
              <span class="pg">{prev.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a href={next.href} rel="next" class="r">
              <span class="pg-label">{t('post.next')}</span>
              <span class="pg">{next.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )}

      {issue && (
        <Comments
          lang={lang}
          repo={issue.repo}
          number={issue.number}
          url={issue.url}
          locked={issue.locked}
          comments={issue.comments}
        />
      )}
      <Mermaid />
    </article>
  </div>
  <button type="button" class="to-top" data-to-top aria-label={t('post.toTop')} title={t('post.toTop')}>
    <svg
      viewBox="0 0 16 16"
      width="15"
      height="15"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M8 13V3.5M3.8 7.5 8 3.3l4.2 4.2" />
    </svg>
  </button>
</Base>

<script>
  import '../scripts/article';
</script>

<style>
  .post {
    max-width: var(--measure);
    padding-top: var(--sp-8);
  }
  /* 返回链接（§7 返回链接）：衬线 fs-meta，弱色，hover 强调色 */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: var(--sp-5);
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    color: var(--ink-muted);
    transition: color var(--dur-2) var(--ease);
  }
  .back-link span {
    transition: transform var(--dur-2) var(--ease);
  }
  .back-link:hover {
    color: var(--accent);
  }
  .back-link:hover span {
    transform: translateX(-2px);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 22px;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    color: var(--n-7);
  }
  .badge {
    font-size: var(--fs-xs);
  }
  .badge.archived {
    color: var(--n-6);
    border-style: dashed;
  }
  .notice {
    margin: -12px 0 24px;
    padding: 8px 12px;
    border-left: 2px solid var(--accent);
    background: var(--accent-8);
    border-radius: 0 6px 6px 0;
  }
  .accent {
    color: var(--accent);
  }
  .post-title {
    margin: 0 0 14px;
    font-size: var(--fs-4xl);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .post-subtitle {
    margin: 0 0 28px;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--n-7);
  }
  .post-author {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 20px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--hair);
  }
  .post-author img {
    width: 36px;
    height: 36px;
    border-radius: var(--r-round);
    object-fit: cover;
  }
  .author-name {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--n-10);
  }
  .author-date {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--n-7);
  }
  .post-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--hair);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--n-7);
  }
  .tags {
    display: flex;
    gap: 12px;
  }
  .tags .tag {
    font-size: var(--fs-xs);
  }
  /* 上一篇 / 下一篇（§7）：无卡片，两栏，mono 小标签 + 衬线标题 */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6);
    margin-top: var(--sp-6);
  }
  .pager a {
    display: grid;
    gap: var(--sp-1);
    align-content: start;
  }
  .pager .r {
    text-align: right;
  }
  .pg-label {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .pg {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: var(--lh-ui);
    color: var(--ink);
    transition: color var(--dur-2) var(--ease);
  }
  .pager a:hover .pg {
    color: var(--accent);
  }
  /* 回到顶部：小号圆形幽灵按钮，滚动后淡入 */
  .to-top {
    position: fixed;
    right: var(--sp-5);
    bottom: var(--sp-5);
    z-index: 60;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0.5px solid var(--border);
    border-radius: var(--r-round);
    background: rgb(var(--paper-rgb) / 0.8);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-pop);
    color: var(--ink-muted);
    cursor: pointer;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }
  .to-top:global(.on) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .to-top:hover {
    color: var(--accent);
  }
  /* 底部 Dock 时浮在 Dock 上方，不与其重叠（§10 窄屏） */
  @media (max-width: 1023.98px) {
    .to-top {
      right: var(--sp-4);
      bottom: var(--dock-bar-clear);
    }
  }
  @media (max-width: 640px) {
    .post {
      padding-top: 40px;
    }
    .post-title {
      font-size: var(--fs-3xl);
    }
    .post-subtitle {
      font-size: var(--fs-ui);
    }
    .pager {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
    .pager .r {
      text-align: left;
    }
  }
</style>
