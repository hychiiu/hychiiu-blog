---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/fonts.css';
import '../styles/global.css';
import { site, type Lang } from '../site.config';
import { htmlLang, localizePath, stripLang, toLang } from '../i18n';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { pageFade } from '../utils/transitions';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** 分享图（文章封面 / 正文第一张图），缺省用头像 */
  image?: string;
  /** 另一语言的等价页面路径；不传则按前缀自动推导 */
  alternates?: Partial<Record<Lang, string>>;
}
const lang = toLang(Astro.currentLocale);
const path = Astro.url.pathname;
const { title, description = site.description[lang], type = 'website', image } = Astro.props;
const alternates: Record<Lang, string> = {
  zh: Astro.props.alternates?.zh ?? localizePath('zh', stripLang(path)),
  en: Astro.props.alternates?.en ?? localizePath('en', stripLang(path)),
};
const base = Astro.site ?? site.url;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(path, base).href;
const ogImage = new URL(image ?? site.avatarLarge, base).href;
const rss = localizePath(lang, '/rss.xml');
---
<!doctype html>
<html
  lang={htmlLang[lang]}
  data-lang={lang}
  data-alt-zh={alternates.zh}
  data-alt-en={alternates.en}
  style={`--accent-light:${site.accent.light};--accent-dark:${site.accent.dark}`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(alternates.zh, base).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, base).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.zh, base).href} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={rss} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#18181a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        // 只在首次整页加载时执行；之后的站内跳转由 ClientRouter 接管
        if (window.__yhBoot) return;
        window.__yhBoot = true;
        const root = document.documentElement;
        // 语言记忆：从站外进入时，若记住的语言与当前页不同，跳到对应语言的等价页面
        try {
          const want = localStorage.getItem('lang');
          const cur = root.dataset.lang;
          const fromOutside = !document.referrer || new URL(document.referrer).origin !== location.origin;
          if (want && want !== cur && fromOutside) {
            const alt = root.getAttribute('data-alt-' + want);
            if (alt && alt !== location.pathname) location.replace(alt + location.search + location.hash);
          }
        } catch (e) {}
        const saved = localStorage.getItem('theme');
        const sys = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = (t) => (root.dataset.theme = t);
        apply(saved || (sys.matches ? 'dark' : 'light'));
        sys.addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) {
            apply(e.matches ? 'dark' : 'light');
            window.dispatchEvent(new CustomEvent('themechange'));
          }
        });
        // 站内跳转：新页面替换前先带上当前主题，避免闪烁
        document.addEventListener('astro:before-swap', (e) => {
          e.newDocument.documentElement.dataset.theme = root.dataset.theme;
        });
        // 记录「发生过站内跳转」，文章页返回链接据此决定用 history.back()
        document.addEventListener('astro:after-swap', () => {
          window.__yhInternalNav = true;
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Dock lang={lang} alternates={alternates} />
    <main transition:animate={pageFade}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
