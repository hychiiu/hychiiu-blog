{
  "name": "hychiiu-blog",
  "version": "1.0.0",
  "description": "hychiiu 的个人主页与博客（Astro 静态站）",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "avatar": "node scripts/avatar.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name hychiiu-blog",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check && tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "astro": "^7.4.10",
    "astro-expressive-code": "^0.44.3",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "simple-icons": "^16.37.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.23"
  }
}
